[Unit]
Description=Iscandar payload install from the host share
DefaultDependencies=no
After=local-fs.target
Before=iscandar-layer.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/iscandar-payload-install
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=multi-user.target
