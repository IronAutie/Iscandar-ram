+		    && iscandar_page_in_arena(area->pages[0])) {
+			struct IscandarBridgeRecord rec = { };
+
+			rec.op = ISCANDAR_OP_VFREE;
+			rec.size =
+				iscandar_page_to_offset(area->pages[0]);
+			(void)iscandar_bridge_call(&rec);
+			return;
+		}
