+/* iscandar_steps.h -- KR12 step counters (patch 0013).
+ *
+ * A step is one iteration of a scanning loop in the search
+ * or commit path (one row, plane, sector position, or cube
+ * examined): the definition of the termination table
+ * (build/kernel/KERNEL-BUILD-DESIGN-DRAFT.md section 4),
+ * first counted by the atomicity simulation at these same
+ * sites (atomic-sim/instrument.py). The simulation kept
+ * search, commit, and gate counters apart and reported
+ * their sum per call; this build keeps the one sum, the
+ * sum being what the table states.
+ *
+ * The counter is a plain global, incremented at the
+ * simulation's sites and nowhere else. Every engine entry
+ * runs inside the core's spin section, the discipline the
+ * simulation's atomic sections modeled, so no atomicity
+ * is wanted: a step charged outside the section would be
+ * a design violation, not a race to defend against.
+ *
+ * A call's count travels up the chain in the result
+ * structs (EngineResult.steps, CubeEngineResult.steps)
+ * and is published by beam_allocate and beam_free in
+ * iscandar_beam_last_steps, which the core's ledgers
+ * read. It does not ride in the Beam struct: the struct's
+ * shape is part of the link-time mass, byte-compared
+ * against a runtime-built Beam (build/kernel/
+ * MASS-LAYOUT.md), and its header is of record.
+ *
+ * The increments are the only statements this patch adds
+ * inside the engine: no control flow, no return value,
+ * and no allocation decision changes. */
+
+#ifndef ISCANDAR_STEPS_H
+#define ISCANDAR_STEPS_H
+
+#include <stdint.h>
+
+extern uint64_t iscandar_step_counter;
+extern uint64_t iscandar_beam_last_steps;
+
+#define ISCANDAR_STEP() do { iscandar_step_counter++; } while (0)
+
+#endif /* ISCANDAR_STEPS_H */
