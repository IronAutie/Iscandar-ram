+static void iscandar_steps_note(enum iscandar_class cl, u64 steps)
+{
+	iscandar_total_steps[cl] += steps;
+	if (steps > iscandar_worst_steps[cl])
+		iscandar_worst_steps[cl] = steps;
+}
