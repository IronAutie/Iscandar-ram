diff --git a/mm/iscandar/Huge.c b/mm/iscandar/Huge.c
new file mode 100644
index 000000000..84e0f2e7b
--- /dev/null
+++ b/mm/iscandar/Huge.c
@@ -0,0 +1,583 @@
+/* Huge.c -- see Huge.h. Transcription of Huge.py; the
+ * Python is the specification. */
+
+#include "Huge.h"
+
+#include "Cube.h"
+#include "Geometry.h"
+#include "Large.h"
+#include "Plane.h"
+#include "status.h"
+
+/* The most recent conviction's full start, (plane, row,
+ * sector) -- self.last_start in the Python. */
+static uint32_t last_plane;
+static uint32_t last_row;
+static uint32_t last_sector;
+
+void huge_range(uint32_t *lo_out, uint32_t *hi_out)
+{
+    *lo_out = PLANE_SECTORS_PER_PLANE + 1;
+    *hi_out = CUBE_SECTORS_PER_CUBE - 1;
+}
+
+static int huge_in_range(uint32_t request)
+{
+    return request >= PLANE_SECTORS_PER_PLANE + 1
+        && request <= CUBE_SECTORS_PER_CUBE - 1;
+}
+
+/* _lead_check_step: one step of the lead analysis. The
+ * pointer has already been decremented by the caller;
+ * verify the row count at it is zero. */
+static int32_t huge_lead_check_step(int32_t pointer,
+                                    const uint32_t *count_rows)
+{
+    if (count_rows[pointer] != 0) {
+        return HUGE_NO_TRAILER_ROW_FAIL;
+    }
+    return GEAR_SUCCESS;
+}
+
+/* _trailing_row_body: one call of the normal driver's
+ * trailing body. Check the row count is zero. */
+static int32_t huge_trailing_row_body(int32_t pointer,
+                                      const uint32_t *count_rows)
+{
+    if (count_rows[pointer] != 0) {
+        return HUGE_ROW_DRIVER_TRAILING_ROW_FAIL;
+    }
+    return GEAR_SUCCESS;
+}
+
+/* _span_free: sector-exact recheck of a proposed span, so
+ * a start is never returned on a handler's arithmetic
+ * alone. Returns 1 only when every sector is free. */
+static int huge_span_free(int64_t start, uint32_t request,
+                          const uint32_t *words)
+{
+    int64_t end;
+    int32_t first_row;
+    int32_t last_row;
+    int32_t g;
+    int32_t lo;
+    int32_t hi;
+    int32_t sector;
+    uint32_t word;
+
+    end = start + (int64_t)request;
+    if (start < 0 || end > CUBE_SECTORS_PER_CUBE) {
+        return 0;
+    }
+    first_row = (int32_t)(start / GEOMETRY_ARITY);
+    last_row  = (int32_t)((end - 1) / GEOMETRY_ARITY);
+    for (g = first_row; g <= last_row; g++) {
+        word = words[g];
+        if (word == 0) {
+            continue;
+        }
+        lo = (g == first_row)
+             ? (int32_t)(start - (int64_t)g * GEOMETRY_ARITY)
+             : 0;
+        hi = (g == last_row)
+             ? (int32_t)(end - (int64_t)g * GEOMETRY_ARITY - 1)
+             : GEOMETRY_ARITY - 1;
+        for (sector = lo; sector <= hi; sector++) {
+            if ((word >> sector) & 1u) {
+                return 0;
+            }
+        }
+    }
+    return 1;
+}
+
+/* _rows_no_leading: the remainder lives in the plane
+ * following the core: trailing rows first, then one
+ * oracle row. Returns a status; on GEAR_SUCCESS
+ * *start_out is the global sector index of the start. */
+static int32_t huge_rows_no_leading(uint32_t candidate,
+                                    uint32_t request,
+                                    const uint32_t *count_planes,
+                                    const uint32_t *count_rows,
+                                    const uint32_t *words,
+                                    int64_t *start_out)
+{
+    uint32_t core;
+    uint32_t remaining;
+    uint32_t following;
+    uint32_t trailing_rows;
+    uint32_t base;
+    uint32_t step;
+    uint32_t row;
+
+    (void)words;
+    core      = request / (GEOMETRY_ARITY * GEOMETRY_ARITY);
+    remaining = request - core * PLANE_SECTORS_PER_PLANE;
+    if (remaining == 0) {
+        *start_out = (int64_t)candidate * PLANE_SECTORS_PER_PLANE;
+        return GEAR_SUCCESS;
+    }
+    following = candidate + core;
+    if (following >= CUBE_PLANES_PER_CUBE) {
+        return HUGE_FAIL;
+    }
+    /* Gate: if the plane following cannot satisfy the
+     * remaining, this named gate fails. */
+    if (PLANE_SECTORS_PER_PLANE - count_planes[following]
+            < remaining) {
+        return HUGE_GATE_TRAILING_PLANE_GATE_FAIL;
+    }
+    /* Rows: every required full row must have a zero
+     * count. */
+    trailing_rows = remaining / GEOMETRY_ARITY;
+    base = following * GEOMETRY_ARITY;
+    for (step = 0; step < trailing_rows; step++) {
+        if (count_rows[base + step] != 0) {
+            return HUGE_TRAILING_ROW_GATE_FAIL;
+        }
+    }
+    remaining = remaining % GEOMETRY_ARITY;
+    /* Oracle: the following row must consult the Left
+     * oracle for a leading series fitting the rest. */
+    if (remaining) {
+        row = base + trailing_rows;
+        if (row >= CUBE_ROWS_PER_CUBE
+                || large_leading_run(words[row]) < remaining) {
+            return HUGE_NO_LEAD_TRAILER_FAIL;
+        }
+    }
+    *start_out = (int64_t)candidate * PLANE_SECTORS_PER_PLANE;
+    return GEAR_SUCCESS;
+}
+
+/* _rows_no_trailing: works backwards from the core; the
+ * remainder lives in the single plane before the core,
+ * reversed into: lead padding rows, then one candidate
+ * row. */
+static int32_t huge_rows_no_trailing(uint32_t candidate,
+                                     uint32_t request,
+                                     const uint32_t *count_planes,
+                                     const uint32_t *count_rows,
+                                     const uint32_t *words,
+                                     int64_t *start_out)
+{
+    uint32_t core;
+    uint32_t remaining;
+    uint32_t lead_rows;
+    uint32_t lead_sectors;
+    int32_t  pointer;
+    uint32_t step;
+    int32_t  status;
+
+    (void)count_planes;
+    core         = request / (GEOMETRY_ARITY * GEOMETRY_ARITY);
+    remaining    = request - core * PLANE_SECTORS_PER_PLANE;
+    if (remaining == 0) {
+        *start_out = (int64_t)candidate * PLANE_SECTORS_PER_PLANE;
+        return GEAR_SUCCESS;
+    }
+    lead_rows    = remaining / GEOMETRY_ARITY;
+    lead_sectors = remaining % GEOMETRY_ARITY;
+    pointer = (int32_t)(candidate * GEOMETRY_ARITY);
+    for (step = 0; step < lead_rows; step++) {
+        pointer -= 1;
+        status = huge_lead_check_step(pointer, count_rows);
+        if (status != GEAR_SUCCESS) {
+            return status;
+        }
+    }
+    if (lead_sectors) {
+        /* One more decrement: the candidate row's free run
+         * at its end must cover the leading sectors still
+         * owed. */
+        pointer -= 1;
+        if (pointer < 0
+                || large_trailing_run(words[pointer])
+                       < lead_sectors) {
+            return HUGE_FAIL;
+        }
+    }
+    *start_out = (int64_t)candidate * PLANE_SECTORS_PER_PLANE
+                 - (int64_t)remaining;
+    return GEAR_SUCCESS;
+}
+
+/* _rows_normal: leader first -- the leading plane gives
+ * what its free suffix has, and the trailing plane
+ * fulfils the rest, mandatorily. */
+static int32_t huge_rows_normal(uint32_t candidate,
+                                uint32_t request,
+                                const uint32_t *count_planes,
+                                const uint32_t *count_rows,
+                                const uint32_t *words,
+                                int64_t *start_out)
+{
+    uint32_t core;
+    uint32_t remaining;
+    int32_t  pointer;
+    int32_t  plane_floor;
+    uint32_t leader_take;
+    int64_t  start;
+    uint32_t still_owed;
+    uint32_t following;
+    uint32_t row;
+    uint32_t trailing_rows;
+    uint32_t step;
+    int32_t  status;
+
+    (void)count_planes;
+    core      = request / (GEOMETRY_ARITY * GEOMETRY_ARITY);
+    remaining = request - core * PLANE_SECTORS_PER_PLANE;
+    if (remaining == 0) {
+        *start_out = (int64_t)candidate * PLANE_SECTORS_PER_PLANE;
+        return GEAR_SUCCESS;
+    }
+
+    /* Leader calculation. Row pointer set to the start of
+     * the core plane; each step decrements it: a zero-count
+     * row counts a full row toward the take, and the first
+     * non-zero row gives its end run and stops the walk.
+     * The walk never leaves the leading plane. */
+    pointer     = (int32_t)(candidate * GEOMETRY_ARITY);
+    plane_floor = pointer - GEOMETRY_ARITY;
+    leader_take = 0;
+    while (leader_take < remaining && pointer > plane_floor) {
+        pointer -= 1;
+        if (count_rows[pointer] == 0) {
+            leader_take += GEOMETRY_ARITY;
+        } else {
+            leader_take += large_trailing_run(words[pointer]);
+            break;
+        }
+    }
+    if (leader_take > remaining) {
+        leader_take = remaining;
+    }
+    start      = (int64_t)candidate * PLANE_SECTORS_PER_PLANE
+                 - (int64_t)leader_take;
+    still_owed = remaining - leader_take;
+    if (still_owed == 0) {
+        *start_out = start;
+        return GEAR_SUCCESS;
+    }
+
+    /* Trailing padding: each required full row after the
+     * core planes must have a zero count; then one more
+     * row is evaluated with the Left oracle for the
+     * sectors still owed. */
+    following     = candidate + core;
+    row           = following * GEOMETRY_ARITY;
+    trailing_rows = still_owed / GEOMETRY_ARITY;
+    for (step = 0; step < trailing_rows; step++) {
+        status = huge_trailing_row_body((int32_t)(row + step),
+                                        count_rows);
+        if (status != GEAR_SUCCESS) {
+            return status;
+        }
+    }
+    still_owed = still_owed % GEOMETRY_ARITY;
+    if (still_owed) {
+        row += trailing_rows;
+        if (row >= CUBE_ROWS_PER_CUBE
+                || large_leading_run(words[row]) < still_owed) {
+            return HUGE_ROW_DRIVER_TRAILER_PADDING_FAIL;
+        }
+    }
+    *start_out = start;
+    return GEAR_SUCCESS;
+}
+
+/* _plane_suffix_take: what a plane can give as a leader:
+ * its free suffix, in sectors. At most one plane. */
+static uint32_t huge_plane_suffix_take(uint32_t plane,
+                                       const uint32_t *count_rows,
+                                       const uint32_t *words)
+{
+    uint32_t take = 0;
+    int32_t  row;
+    int32_t  floor_row;
+
+    row       = (int32_t)((plane + 1) * GEOMETRY_ARITY - 1);
+    floor_row = (int32_t)(plane * GEOMETRY_ARITY);
+    while (row >= floor_row) {
+        if (count_rows[row] == 0) {
+            take += GEOMETRY_ARITY;
+            row  -= 1;
+        } else {
+            take += large_trailing_run(words[row]);
+            break;
+        }
+    }
+    return take;
+}
+
+/* _plane_prefix_take: what a plane can give as a trailer:
+ * its free prefix, in sectors. At most one plane. */
+static uint32_t huge_plane_prefix_take(uint32_t plane,
+                                       const uint32_t *count_rows,
+                                       const uint32_t *words)
+{
+    uint32_t take = 0;
+    uint32_t row;
+    uint32_t ceil_row;
+
+    row      = plane * GEOMETRY_ARITY;
+    ceil_row = (plane + 1) * GEOMETRY_ARITY;
+    while (row < ceil_row) {
+        if (count_rows[row] == 0) {
+            take += GEOMETRY_ARITY;
+            row  += 1;
+        } else {
+            take += large_leading_run(words[row]);
+            break;
+        }
+    }
+    return take;
+}
+
+/* _split_attempt: one split candidate -- core - 1 empty
+ * planes starting at seam, flanked by both edge planes.
+ * The edges together must cover the need, remaining plus
+ * one plane; the leader is taken first, the trailer must
+ * fulfil the rest. Returns 1 with *start_out set, else 0. */
+static int huge_split_attempt(uint32_t seam, uint32_t request,
+                              const uint32_t *count_planes,
+                              const uint32_t *count_rows,
+                              const uint32_t *words,
+                              int64_t *start_out)
+{
+    uint32_t core;
+    uint32_t width;
+    uint32_t remaining;
+    uint32_t follower;
+    uint32_t need;
+    uint32_t leader_take;
+    uint32_t still_owed;
+    uint32_t trailer_take;
+
+    core      = request / (GEOMETRY_ARITY * GEOMETRY_ARITY);
+    width     = core - 1;
+    remaining = request % (GEOMETRY_ARITY * GEOMETRY_ARITY);
+    for (follower = seam; follower < seam + width; follower++) {
+        if (count_planes[follower] != 0) {
+            return 0;
+        }
+    }
+    need        = remaining + PLANE_SECTORS_PER_PLANE;
+    leader_take = huge_plane_suffix_take(seam - 1, count_rows,
+                                         words);
+    if (leader_take > need) {
+        leader_take = need;
+    }
+    still_owed = need - leader_take;
+    if (still_owed > 0) {
+        trailer_take = huge_plane_prefix_take(seam + width,
+                                              count_rows, words);
+        if (trailer_take < still_owed) {
+            return 0;
+        }
+    }
+    *start_out = (int64_t)seam * PLANE_SECTORS_PER_PLANE
+                 - (int64_t)leader_take;
+    return 1;
+}
+
+/* _rows_split: the split handler, a thin wrapper over
+ * _split_attempt so the named failure has the one return
+ * site the status discipline wants. */
+static int32_t huge_rows_split(uint32_t seam, uint32_t request,
+                               const uint32_t *count_planes,
+                               const uint32_t *count_rows,
+                               const uint32_t *words,
+                               int64_t *start_out)
+{
+    if (!huge_split_attempt(seam, request, count_planes,
+                            count_rows, words, start_out)) {
+        return HUGE_SPLIT_FAIL;
+    }
+    return GEAR_SUCCESS;
+}
+
+/* Record a convicted global start in the last-start state
+ * and in the bullet's sector cell, as both Huge bullets
+ * do in the Python. */
+static int32_t huge_convict(int64_t start, uint32_t *sector_out)
+{
+    last_plane  = (uint32_t)(start / PLANE_SECTORS_PER_PLANE);
+    last_row    = (uint32_t)((start % PLANE_SECTORS_PER_PLANE)
+                             / GEOMETRY_ARITY);
+    last_sector = (uint32_t)(start % GEOMETRY_ARITY);
+    *sector_out = last_sector;
+    return GEAR_SUCCESS;
+}
+
+/* _split_call: the bullet for one split candidate. seam
+ * is the first of the core - 1 empty planes (for core = 1,
+ * the trailer plane of the boundary). */
+static int32_t huge_split_call(uint32_t seam, uint32_t request,
+                               const HugeCtx *ctx,
+                               uint32_t *sector_out)
+{
+    uint32_t core;
+    int32_t  status;
+    int64_t  start;
+
+    if (!huge_in_range(request)) {
+        return HUGE_SPLIT_FAIL;
+    }
+    core = request / (GEOMETRY_ARITY * GEOMETRY_ARITY);
+    if (seam < 1 || seam + core - 1 > CUBE_PLANES_PER_CUBE - 1) {
+        return HUGE_SPLIT_FAIL;
+    }
+    status = huge_rows_split(seam, request, ctx->count_planes,
+                             ctx->count_rows, ctx->words, &start);
+    if (status != GEAR_SUCCESS) {
+        return status;
+    }
+    if (!huge_span_free(start, request, ctx->words)) {
+        return HUGE_FAIL;
+    }
+    return huge_convict(start, sector_out);
+}
+
+int32_t huge_bullet(uint32_t plane, uint32_t row,
+                    uint32_t request, void *ctx,
+                    uint32_t *sector_out)
+{
+    const HugeCtx *hctx = (const HugeCtx *)ctx;
+    uint32_t core;
+    uint32_t follower;
+    int32_t  status;
+    int64_t  start;
+
+    (void)row;
+    if (!huge_in_range(request)) {
+        return HUGE_FAIL;
+    }
+    core = request / (GEOMETRY_ARITY * GEOMETRY_ARITY);
+    if (plane + core > CUBE_PLANES_PER_CUBE) {
+        return HUGE_FAIL;
+    }
+    for (follower = plane; follower < plane + core; follower++) {
+        if (hctx->count_planes[follower] != 0) {
+            return HUGE_FAIL;
+        }
+    }
+    if (plane == 0) {
+        status = huge_rows_no_leading(plane, request,
+                                      hctx->count_planes,
+                                      hctx->count_rows,
+                                      hctx->words, &start);
+    } else if (plane + core - 1 == CUBE_PLANES_PER_CUBE - 1) {
+        status = huge_rows_no_trailing(plane, request,
+                                       hctx->count_planes,
+                                       hctx->count_rows,
+                                       hctx->words, &start);
+    } else {
+        status = huge_rows_normal(plane, request,
+                                  hctx->count_planes,
+                                  hctx->count_rows,
+                                  hctx->words, &start);
+    }
+    if (status != GEAR_SUCCESS) {
+        return status;
+    }
+    if (!huge_span_free(start, request, hctx->words)) {
+        return HUGE_FAIL;
+    }
+    return huge_convict(start, sector_out);
+}
+
+void huge_last_start(uint32_t *plane_out, uint32_t *row_out,
+                     uint32_t *sector_out)
+{
+    *plane_out  = last_plane;
+    *row_out    = last_row;
+    *sector_out = last_sector;
+}
+
+/* _planes_driver: first sweep, each plane in turn as the
+ * first of the core planes, firing the bullet; second
+ * sweep, only when the first finds nothing, the split
+ * candidates via the split bullet. On a conviction the
+ * start is written from the last-start state and 1 is
+ * returned; else 0. */
+static int huge_planes_driver(uint32_t request,
+                              const uint32_t *count_planes,
+                              const uint32_t *count_rows,
+                              const uint32_t *words,
+                              uint32_t *start_out)
+{
+    HugeCtx  ctx;
+    uint32_t core;
+    uint32_t width;
+    uint32_t candidate;
+    uint32_t seam;
+    uint32_t sector_out;
+    int32_t  status;
+
+    ctx.count_planes = count_planes;
+    ctx.count_rows   = count_rows;
+    ctx.words        = words;
+
+    core      = request / (GEOMETRY_ARITY * GEOMETRY_ARITY);
+    candidate = 0;
+    while (candidate + core <= CUBE_PLANES_PER_CUBE) {
+        if (count_planes[candidate] == 0) {
+            sector_out = 0;
+            status = huge_bullet(candidate, 0, request,
+                                 (void *)&ctx, &sector_out);
+            if (status == GEAR_SUCCESS) {
+                huge_last_start(&start_out[0], &start_out[1],
+                                &start_out[2]);
+                return 1;
+            }
+        }
+        candidate += 1;
+    }
+    /* Second sweep, the 2026-10-26 amendment: seams run
+     * 1 .. 31 - (core - 1), so the head plane and the
+     * trailer plane both always exist. */
+    width = core - 1;
+    seam  = 1;
+    while (seam + width <= CUBE_PLANES_PER_CUBE - 1) {
+        sector_out = 0;
+        status = huge_split_call(seam, request, &ctx,
+                                 &sector_out);
+        if (status == GEAR_SUCCESS) {
+            huge_last_start(&start_out[0], &start_out[1],
+                            &start_out[2]);
+            return 1;
+        }
+        seam += 1;
+    }
+    return 0;
+}
+
+int32_t huge_search(uint32_t request,
+                    const uint32_t *count_planes,
+                    const uint32_t *count_rows,
+                    const uint32_t *words,
+                    uint32_t *plane_out, uint32_t *row_out,
+                    uint32_t *sector_out)
+{
+    uint32_t start[3];
+
+    if (!huge_in_range(request)) {
+        *plane_out  = 0;
+        *row_out    = 0;
+        *sector_out = 0;
+        return HUGE_FAIL;
+    }
+    if (!huge_planes_driver(request, count_planes, count_rows,
+                            words, start)) {
+        *plane_out  = 0;
+        *row_out    = 0;
+        *sector_out = 0;
+        return GEAR_EXHAUST;
+    }
+    *plane_out  = start[0];
+    *row_out    = start[1];
+    *sector_out = start[2];
+    return GEAR_SUCCESS;
+}
diff --git a/mm/iscandar/Huge.h b/mm/iscandar/Huge.h
new file mode 100644
index 000000000..88c2bd8ae
--- /dev/null
+++ b/mm/iscandar/Huge.h
@@ -0,0 +1,73 @@
+/* Huge.h -- transcription of Huge.py, the author's
+ * design; the Python is the specification and this code
+ * reproduces it exactly. Transcription only: no original
+ * content. */
+
+#ifndef ISCANDAR_HUGE_H
+#define ISCANDAR_HUGE_H
+
+#include <stdint.h>
+
+/* class Huge (Mode): the request mode for 1025..32767
+ * sectors (A^2 < L <= A^3 - 1), dispatched by the Modes
+ * table. Rederived from requirements (Huge.py's blackboard,
+ * 53 facts, plus the 2026-10-26 split-edge second sweep):
+ * core planes counted first, then a leading and a trailing
+ * plane; three row handlers (no leading, no trailing,
+ * normal) fire per candidate position, and named failure
+ * codes mark the exact acquittal site for breakpointing.
+ * Huge.search in the Python is its own plane driver over
+ * those handlers -- no DLL gear -- and so is this
+ * transcription. */
+
+/* The bullet context of the Python: the tuple
+ * (count_planes, count_rows, words) that Huge.__call__ and
+ * the split bullet unpack. */
+typedef struct {
+    const uint32_t *count_planes;
+    const uint32_t *count_rows;
+    const uint32_t *words;
+} HugeCtx;
+
+/* Huge.range(): inclusive(SECTORS_PER_PLANE + 1,
+ * SECTORS_PER_CUBE - 1) -- 1025..32767. Reported as the
+ * inclusive bounds. */
+__declspec(dllexport)
+void huge_range(uint32_t *lo_out, uint32_t *hi_out);
+
+/* The bullet: __call__ for one candidate. plane is the
+ * candidate's first core plane; row is unused, because a
+ * core candidate is a plane. ctx is a HugeCtx. On
+ * GEAR_SUCCESS *sector_out takes the start sector within
+ * the start row and the full start is kept for
+ * huge_last_start; on failure the handler's named status
+ * is returned, for breakpointing. */
+__declspec(dllexport)
+int32_t huge_bullet(uint32_t plane, uint32_t row,
+                    uint32_t request, void *ctx,
+                    uint32_t *sector_out);
+
+/* The full start of the most recent huge_bullet or split
+ * conviction: (plane, row, sector). In the Python this is
+ * the mode instance's last_start attribute; here it is
+ * file state, in the manner of the gears' bound handler
+ * state. Meaningful only immediately after a GEAR_SUCCESS
+ * that set it. */
+__declspec(dllexport)
+void huge_last_start(uint32_t *plane_out, uint32_t *row_out,
+                     uint32_t *sector_out);
+
+/* Huge.search: the plane driver's two sweeps. The return
+ * is the uniform gear outcome: on GEAR_SUCCESS the start
+ * (plane, row, sector); HUGE_FAIL when the request is
+ * outside the mode's range; GEAR_EXHAUST when no candidate
+ * in either sweep fits. */
+__declspec(dllexport)
+int32_t huge_search(uint32_t request,
+                    const uint32_t *count_planes,
+                    const uint32_t *count_rows,
+                    const uint32_t *words,
+                    uint32_t *plane_out, uint32_t *row_out,
+                    uint32_t *sector_out);
+
+#endif /* ISCANDAR_HUGE_H */
diff --git a/mm/iscandar/K4Status.h b/mm/iscandar/K4Status.h
new file mode 100644
index 000000000..b0cc178f6
--- /dev/null
+++ b/mm/iscandar/K4Status.h
@@ -0,0 +1,23 @@
+/* K4Status.h -- status codes for the k=4 C transcription.
+ *
+ * The values mirror Status.py, the ONE canonical home for status
+ * codes in the k=3 engine (see status.h there, generated from
+ * Status.py by gen_status.py). They are copied here so the k=4 C
+ * files stand alone in this repository; they must never drift
+ * from Status.py. If Status.py changes, this file changes with
+ * it, by hand, in the same commit.
+ *
+ * Doctrine (project law): a failure returns a status code. It
+ * never crashes, never aborts, is never retried silently, and is
+ * never papered over by a fallback. */
+
+#ifndef ISCANDAR_K4_STATUS_H
+#define ISCANDAR_K4_STATUS_H
+
+#define K4_SUCCESS       0  /* Status.py: SUCCESS */
+#define K4_FAIL          1  /* Status.py: FAIL */
+#define K4_GEAR_EXHAUST  2  /* Status.py: GEAR_EXHAUST */
+#define K4_FAIL_OVERLAY  4  /* Status.py: FAIL_OVERLAY */
+#define K4_GEAR_SUCCESS  8  /* Status.py: GEAR_SUCCESS */
+
+#endif /* ISCANDAR_K4_STATUS_H */
diff --git a/mm/iscandar/Large.c b/mm/iscandar/Large.c
new file mode 100644
index 000000000..819da93ca
--- /dev/null
+++ b/mm/iscandar/Large.c
@@ -0,0 +1,411 @@
+/* Large.c -- see Large.h. Transcription of Large.py; the
+ * Python is the specification. */
+
+#include "Large.h"
+
+#include "Geometry.h"
+#include "Plane.h"
+#include "Row.h"
+#include "status.h"
+
+/* The most recent conviction's full start, (plane, row,
+ * sector) -- self.last_start in the Python. */
+static uint32_t last_plane;
+static uint32_t last_row;
+static uint32_t last_sector;
+
+void large_range(uint32_t *lo_out, uint32_t *hi_out)
+{
+    *lo_out = ROW_SECTORS_TWEEN_ROWS + 1;
+    *hi_out = PLANE_SECTORS_PER_PLANE;
+}
+
+uint32_t large_trailing_run(uint32_t word)
+{
+    uint32_t run = 0;
+    uint32_t sector;
+
+    for (sector = 32; sector-- > 0; ) {
+        if (((word >> sector) & 1u) == 0) {
+            run += 1;
+        } else {
+            break;
+        }
+    }
+    return run;
+}
+
+uint32_t large_leading_run(uint32_t word)
+{
+    uint32_t run = 0;
+    uint32_t sector;
+
+    for (sector = 0; sector < 32; sector++) {
+        if (((word >> sector) & 1u) == 0) {
+            run += 1;
+        } else {
+            break;
+        }
+    }
+    return run;
+}
+
+static int large_in_range(uint32_t request)
+{
+    return request >= ROW_SECTORS_TWEEN_ROWS + 1
+        && request <= PLANE_SECTORS_PER_PLANE;
+}
+
+/* _probe: one core start. On a fit, write the start
+ * coordinate (plane, row, sector) and return 1; else
+ * return 0. core_start is a global row index. */
+static int large_probe(int32_t core_start, uint32_t request,
+                       const uint32_t *words,
+                       uint32_t *start_out)
+{
+    uint32_t core;
+    uint32_t remainder;
+    int32_t  head_row;
+    int32_t  tail_row;
+    int32_t  g;
+    uint32_t head_len;
+    uint32_t head_take;
+    uint32_t remaining;
+
+    if (!large_in_range(request)) {
+        return 0;
+    }
+    core      = request / GEOMETRY_ARITY;
+    remainder = request % GEOMETRY_ARITY;
+    if (core_start < 0 || core_start + (int32_t)core > 1024) {
+        return 0;
+    }
+    for (g = core_start; g < core_start + (int32_t)core; g++) {
+        if (words[g] != 0) {
+            return 0;
+        }
+    }
+    if (remainder == 0) {
+        start_out[0] = (uint32_t)core_start / GEOMETRY_ARITY;
+        start_out[1] = (uint32_t)core_start % GEOMETRY_ARITY;
+        start_out[2] = 0;
+        return 1;
+    }
+    head_row = core_start - 1;
+    tail_row = core_start + (int32_t)core;
+    if (core_start == 0) {
+        /* Scenario (a): no head; the following row's
+         * leading sectors must satisfy the remainder. */
+        if (tail_row >= 1024) {
+            return 0;
+        }
+        if (large_leading_run(words[tail_row]) < remainder) {
+            return 0;
+        }
+        start_out[0] = 0;
+        start_out[1] = 0;
+        start_out[2] = 0;
+        return 1;
+    }
+    if (core_start + (int32_t)core - 1 == 1023) {
+        /* Scenario (b): no tail; the previous row's
+         * trailing sectors must satisfy the remainder. */
+        if (head_row < 0) {
+            return 0;
+        }
+        if (large_trailing_run(words[head_row]) < remainder) {
+            return 0;
+        }
+        start_out[0] = (uint32_t)head_row / GEOMETRY_ARITY;
+        start_out[1] = (uint32_t)head_row % GEOMETRY_ARITY;
+        start_out[2] = 32 - remainder;
+        return 1;
+    }
+    /* Scenario (c): both rows exist. Right oracle first, as
+     * many trailing sectors as will fit; then the Left
+     * oracle for what remains owed. */
+    head_len  = large_trailing_run(words[head_row]);
+    head_take = head_len < remainder ? head_len : remainder;
+    remaining = remainder - head_take;
+    if (remaining == 0) {
+        start_out[0] = (uint32_t)head_row / GEOMETRY_ARITY;
+        start_out[1] = (uint32_t)head_row % GEOMETRY_ARITY;
+        start_out[2] = 32 - head_take;
+        return 1;
+    }
+    if (tail_row >= 1024) {
+        return 0;
+    }
+    if (large_leading_run(words[tail_row]) < remaining) {
+        return 0;
+    }
+    if (head_take > 0) {
+        start_out[0] = (uint32_t)head_row / GEOMETRY_ARITY;
+        start_out[1] = (uint32_t)head_row % GEOMETRY_ARITY;
+        start_out[2] = 32 - head_take;
+        return 1;
+    }
+    start_out[0] = (uint32_t)core_start / GEOMETRY_ARITY;
+    start_out[1] = (uint32_t)core_start % GEOMETRY_ARITY;
+    start_out[2] = 0;
+    return 1;
+}
+
+/* _rows_driver: the row level handler for one launching
+ * plane. The window sum is built once for the first start
+ * in the plane, then rolled one row at a time; no loop
+ * traverses the core per candidate. */
+static int large_rows_driver(uint32_t plane, uint32_t request,
+                             const uint32_t *count_rows,
+                             const uint32_t *words,
+                             uint32_t *start_out)
+{
+    uint32_t core;
+    uint32_t first;
+    int32_t  window_sum;
+    uint32_t core_start;
+    uint32_t g;
+
+    core  = request / GEOMETRY_ARITY;
+    first = plane * GEOMETRY_ARITY;
+    if (first + core > 1024) {
+        return 0;
+    }
+    window_sum = 0;
+    for (g = first; g < first + core; g++) {
+        window_sum += (int32_t)count_rows[g];
+    }
+    core_start = first;
+    while (core_start < first + GEOMETRY_ARITY) {
+        if (core_start + core > 1024) {
+            break;
+        }
+        if (window_sum == 0) {
+            if (large_probe((int32_t)core_start, request,
+                            words, start_out)) {
+                return 1;
+            }
+        }
+        if (core_start + core < 1024) {
+            window_sum += (int32_t)count_rows[core_start + core]
+                        - (int32_t)count_rows[core_start];
+        }
+        core_start += 1;
+    }
+    return 0;
+}
+
+/* _probe_split: one core start of the second pass, the
+ * split-edge case, f = core - 1 blank rows. The head row's
+ * trailing run is taken whole toward the budget (budget =
+ * remainder + arity); the tail row must cover the rest
+ * with its leading run. */
+static int large_probe_split(int32_t core_start,
+                             uint32_t request,
+                             const uint32_t *words,
+                             uint32_t *start_out)
+{
+    uint32_t core;
+    int32_t  width;
+    int32_t  g;
+    int32_t  budget;
+    int32_t  head_take;
+    int32_t  owed;
+    int32_t  tail_row;
+    int32_t  start;
+
+    if (!large_in_range(request)) {
+        return 0;
+    }
+    core  = request / GEOMETRY_ARITY;
+    width = (int32_t)core - 1;
+    if (core_start < 0 || core_start + width > 1024) {
+        return 0;
+    }
+    for (g = core_start; g < core_start + width; g++) {
+        if (words[g] != 0) {
+            return 0;
+        }
+    }
+    budget    = (int32_t)request - width * GEOMETRY_ARITY;
+    head_take = 0;
+    if (core_start > 0) {
+        head_take = (int32_t)large_trailing_run(
+            words[core_start - 1]);
+    }
+    owed = budget - head_take;
+    if (owed <= 0) {
+        return 0;
+    }
+    tail_row = core_start + width;
+    if (tail_row >= 1024) {
+        return 0;
+    }
+    if ((int32_t)large_leading_run(words[tail_row]) < owed) {
+        return 0;
+    }
+    start = core_start * GEOMETRY_ARITY - head_take;
+    start_out[0] = (uint32_t)start / PLANE_SECTORS_PER_PLANE;
+    start_out[1] = ((uint32_t)start % PLANE_SECTORS_PER_PLANE)
+                   / GEOMETRY_ARITY;
+    start_out[2] = (uint32_t)start % GEOMETRY_ARITY;
+    return 1;
+}
+
+/* _rows_driver_split: the second-pass row handler, the
+ * first pass's rolling window at width core - 1. */
+static int large_rows_driver_split(uint32_t plane,
+                                   uint32_t request,
+                                   const uint32_t *count_rows,
+                                   const uint32_t *words,
+                                   uint32_t *start_out)
+{
+    uint32_t core;
+    int32_t  width;
+    uint32_t first;
+    int32_t  window_sum;
+    uint32_t core_start;
+    uint32_t g;
+
+    core  = request / GEOMETRY_ARITY;
+    width = (int32_t)core - 1;
+    first = plane * GEOMETRY_ARITY;
+    if (width < 1 || first + (uint32_t)width > 1024) {
+        return 0;
+    }
+    window_sum = 0;
+    for (g = first; g < first + (uint32_t)width; g++) {
+        window_sum += (int32_t)count_rows[g];
+    }
+    core_start = first;
+    while (core_start < first + GEOMETRY_ARITY) {
+        if (core_start + (uint32_t)width > 1024) {
+            break;
+        }
+        if (window_sum == 0) {
+            if (large_probe_split((int32_t)core_start, request,
+                                  words, start_out)) {
+                return 1;
+            }
+        }
+        if (core_start + (uint32_t)width < 1024) {
+            window_sum += (int32_t)count_rows[core_start
+                                              + (uint32_t)width]
+                        - (int32_t)count_rows[core_start];
+        }
+        core_start += 1;
+    }
+    return 0;
+}
+
+/* _planes_driver: two passes over the launchings in
+ * ascending plane order. Pass one under the launch gate
+ * (the free sectors of the starting plane plus the next
+ * plane must reach the request; for plane 31 its own free
+ * alone). Pass two, the 2026-10-26 amendment, runs only
+ * when pass one finds nothing: the same launchings with
+ * the split rows driver, under the launch gate plus the
+ * free count of the single head row before the launching
+ * plane. */
+static int large_planes_driver(uint32_t request,
+                               const uint32_t *count_planes,
+                               const uint32_t *count_rows,
+                               const uint32_t *words,
+                               uint32_t *start_out)
+{
+    uint32_t plane;
+    uint32_t free_here;
+    uint32_t free_next;
+    uint32_t head_allowance;
+
+    for (plane = 0; plane < GEOMETRY_ARITY; plane++) {
+        free_here = PLANE_SECTORS_PER_PLANE - count_planes[plane];
+        free_next = 0;
+        if (plane + 1 < GEOMETRY_ARITY) {
+            free_next = PLANE_SECTORS_PER_PLANE
+                        - count_planes[plane + 1];
+        }
+        if (free_here + free_next < request) {
+            continue;
+        }
+        if (large_rows_driver(plane, request, count_rows,
+                              words, start_out)) {
+            return 1;
+        }
+    }
+    for (plane = 0; plane < GEOMETRY_ARITY; plane++) {
+        free_here = PLANE_SECTORS_PER_PLANE - count_planes[plane];
+        free_next = 0;
+        if (plane + 1 < GEOMETRY_ARITY) {
+            free_next = PLANE_SECTORS_PER_PLANE
+                        - count_planes[plane + 1];
+        }
+        head_allowance = 0;
+        if (plane > 0) {
+            head_allowance = ROW_SECTORS_PER_ROW
+                - count_rows[plane * GEOMETRY_ARITY - 1];
+        }
+        if (free_here + free_next + head_allowance < request) {
+            continue;
+        }
+        if (large_rows_driver_split(plane, request, count_rows,
+                                    words, start_out)) {
+            return 1;
+        }
+    }
+    return 0;
+}
+
+int32_t large_bullet(uint32_t plane, uint32_t row,
+                     uint32_t request, void *ctx,
+                     uint32_t *sector_out)
+{
+    const uint32_t *words = (const uint32_t *)ctx;
+    uint32_t start[3];
+
+    if (!large_probe((int32_t)(plane * GEOMETRY_ARITY + row),
+                     request, words, start)) {
+        return LARGE_FAIL;
+    }
+    last_plane  = start[0];
+    last_row    = start[1];
+    last_sector = start[2];
+    *sector_out = start[2];
+    return GEAR_SUCCESS;
+}
+
+void large_last_start(uint32_t *plane_out, uint32_t *row_out,
+                      uint32_t *sector_out)
+{
+    *plane_out  = last_plane;
+    *row_out    = last_row;
+    *sector_out = last_sector;
+}
+
+int32_t large_search(uint32_t request,
+                     const uint32_t *count_planes,
+                     const uint32_t *count_rows,
+                     const uint32_t *words,
+                     uint32_t *plane_out, uint32_t *row_out,
+                     uint32_t *sector_out)
+{
+    uint32_t start[3];
+
+    if (!large_in_range(request)) {
+        *plane_out = 0;
+        *row_out   = 0;
+        *sector_out = 0;
+        return LARGE_FAIL;
+    }
+    if (!large_planes_driver(request, count_planes, count_rows,
+                             words, start)) {
+        *plane_out = 0;
+        *row_out   = 0;
+        *sector_out = 0;
+        return GEAR_EXHAUST;
+    }
+    *plane_out  = start[0];
+    *row_out    = start[1];
+    *sector_out = start[2];
+    return GEAR_SUCCESS;
+}
diff --git a/mm/iscandar/Large.h b/mm/iscandar/Large.h
new file mode 100644
index 000000000..929f71ef8
--- /dev/null
+++ b/mm/iscandar/Large.h
@@ -0,0 +1,75 @@
+/* Large.h -- transcription of Large.py, the author's
+ * design; the Python is the specification and this code
+ * reproduces it exactly. Transcription only: no original
+ * content. */
+
+#ifndef ISCANDAR_LARGE_H
+#define ISCANDAR_LARGE_H
+
+#include <stdint.h>
+
+/* class Large (Mode): the request mode for 65..1024
+ * sectors (2A < L <= A^2), dispatched by the Modes table.
+ * Rederived from requirements (Large.py's blackboard, items
+ * 1 to 9, including the 2026-10-26 split-edge amendment):
+ * Option A, consecutive full rows for the midsection, a
+ * head and/or tail edge satisfying the remainder, and a
+ * second pass at core - 1 blank rows when the first finds
+ * no launching. Large.search in the Python is its own
+ * plane driver over its own row driver over the per-start
+ * probe -- no DLL gear -- and so is this transcription. */
+
+/* Large.range(): inclusive(SECTORS_TWEEN_ROWS + 1,
+ * SECTORS_PER_PLANE) -- 65..1024. Reported as the
+ * inclusive bounds. */
+__declspec(dllexport)
+void large_range(uint32_t *lo_out, uint32_t *hi_out);
+
+/* The two row-word oracles of Large.py, shared with Huge:
+ * the free run ending at sector 31 (Right oracle), and the
+ * free run starting at sector 0 (Left oracle). A word with
+ * the edge sector occupied gives 0; a wholly clear word
+ * gives 32. They cannot fail. */
+__declspec(dllexport)
+uint32_t large_trailing_run(uint32_t word);
+__declspec(dllexport)
+uint32_t large_leading_run(uint32_t word);
+
+/* The bullet: __call__ for one core start, shaped like the
+ * other modes' bullets. plane, row are the core start in
+ * plane/row form; ctx is the sectors words array;
+ * *sector_out takes the start sector on conviction
+ * (GEAR_SUCCESS), and the full start is kept for
+ * large_last_start, because a Large start can sit in the
+ * head row, in a different plane from the core start, and
+ * the bullet contract carries only one sector cell.
+ * Acquittal is LARGE_FAIL. */
+__declspec(dllexport)
+int32_t large_bullet(uint32_t plane, uint32_t row,
+                     uint32_t request, void *ctx,
+                     uint32_t *sector_out);
+
+/* The full start of the most recent large_bullet
+ * conviction: (plane, row, sector). In the Python this is
+ * the mode instance's last_start attribute; here it is
+ * file state, in the manner of the gears' bound handler
+ * state. Meaningful only immediately after a GEAR_SUCCESS
+ * from large_bullet. */
+__declspec(dllexport)
+void large_last_start(uint32_t *plane_out, uint32_t *row_out,
+                      uint32_t *sector_out);
+
+/* Large.search: the plane driver's two passes. The return
+ * is the uniform gear outcome: on GEAR_SUCCESS the start
+ * (plane, row, sector); LARGE_FAIL when the request is
+ * outside the mode's range; GEAR_EXHAUST when no launching
+ * in either pass fits. */
+__declspec(dllexport)
+int32_t large_search(uint32_t request,
+                     const uint32_t *count_planes,
+                     const uint32_t *count_rows,
+                     const uint32_t *words,
+                     uint32_t *plane_out, uint32_t *row_out,
+                     uint32_t *sector_out);
+
+#endif /* ISCANDAR_LARGE_H */
diff --git a/mm/iscandar/MPUPointer.c b/mm/iscandar/MPUPointer.c
new file mode 100644
index 000000000..c22b40917
--- /dev/null
+++ b/mm/iscandar/MPUPointer.c
@@ -0,0 +1,142 @@
+/* MPUPointer.c -- see MPUPointer.h. Transcription of
+ * MPUPointer.py; the Python is the specification. */
+
+#include "MPUPointer.h"
+
+#include "Bijection.h"
+#include "status.h"
+
+int32_t mpupointer_adopt(uint64_t word, uint32_t *word_out)
+{
+    /* __new__: not 0 <= word <= MAX_WORD is refused. */
+    if (word > (uint64_t)MPUPOINTER_MAX_WORD) {
+        return POINTER_ADOPT_WORD_FAIL;
+    }
+    *word_out = (uint32_t)word;
+    return SUCCESS;
+}
+
+int32_t mpupointer_load(uint32_t start, uint32_t count,
+                        uint32_t reserved, int order,
+                        uint32_t *word_out)
+{
+    uint32_t stored;
+
+    /* Creation always raises Virtual: virtual = 1, below. The
+     * Python validates reserved, then start, then count, then
+     * dispatches on order; the checks run in that same order
+     * here, each returning its own per-site code, so a call
+     * violating two rules names the site the Python's first
+     * raise names. All checks run before the pack, so a
+     * refusal writes nothing. */
+    if (reserved != 0 && reserved != 1) {
+        return POINTER_LOAD_RESERVED_FAIL;
+    }
+    if (start > (uint32_t)MPUPOINTER_MAX_START) {
+        return POINTER_LOAD_START_FAIL;
+    }
+    if (count < 1 || count > (uint32_t)MPUPOINTER_MAX_COUNT) {
+        return POINTER_LOAD_COUNT_FAIL;
+    }
+    if (order != MPUPOINTER_MOTOROLA && order != MPUPOINTER_INTEL) {
+        return POINTER_LOAD_ORDER_FAIL;
+    }
+
+    stored = count - 1;
+    if (order == MPUPOINTER_INTEL) {
+        /* bitstruct 'u15u15u1u1', packed (stored, start,
+         * reserved, virtual) MSB first: stored at bits 31..17,
+         * start at bits 16..2, reserved at bit 1, virtual at
+         * bit 0 -- the fields declared from the low end up. */
+        *word_out = (stored << 17) | (start << 2)
+                  | (reserved << 1) | 1u;
+    } else {
+        /* bitstruct 'u1u1u15u15', packed (virtual, reserved,
+         * start, stored) MSB first. */
+        *word_out = (1u << 31) | (reserved << 30)
+                  | (start << 15) | stored;
+    }
+    return SUCCESS;
+}
+
+int32_t mpupointer_load_coordinate(const Coordinate *coordinate,
+                                   uint32_t count,
+                                   uint32_t reserved, int order,
+                                   uint32_t *word_out)
+{
+    /* cls.load(coordinate.displacement, count, reserved,
+     * order): the displacement walks in as load's start. */
+    return mpupointer_load(coordinate_displacement(coordinate),
+                           count, reserved, order, word_out);
+}
+
+int32_t mpupointer_unload(uint32_t word, int order,
+                          MPUPointerFields *fields_out)
+{
+    uint32_t stored;
+
+    if (order == MPUPOINTER_INTEL) {
+        stored              = (word >> 17) & 0x7FFFu;
+        fields_out->start   = (word >> 2) & 0x7FFFu;
+        fields_out->reserved = (word >> 1) & 1u;
+        fields_out->virtual = word & 1u;
+    } else if (order == MPUPOINTER_MOTOROLA) {
+        fields_out->virtual  = (word >> 31) & 1u;
+        fields_out->reserved = (word >> 30) & 1u;
+        fields_out->start    = (word >> 15) & 0x7FFFu;
+        stored               = word & 0x7FFFu;
+    } else {
+        return POINTER_UNLOAD_ORDER_FAIL;
+    }
+    /* The count back in true form: stored + 1. */
+    fields_out->count = stored + 1;
+    return SUCCESS;
+}
+
+uint32_t mpupointer_virtual(uint32_t word)
+{
+    MPUPointerFields fields;
+
+    /* The Motorola unload of a word cannot fail. */
+    (void)mpupointer_unload(word, MPUPOINTER_MOTOROLA, &fields);
+    return fields.virtual;
+}
+
+uint32_t mpupointer_reserved(uint32_t word)
+{
+    MPUPointerFields fields;
+
+    (void)mpupointer_unload(word, MPUPOINTER_MOTOROLA, &fields);
+    return fields.reserved;
+}
+
+uint32_t mpupointer_start(uint32_t word)
+{
+    MPUPointerFields fields;
+
+    (void)mpupointer_unload(word, MPUPOINTER_MOTOROLA, &fields);
+    return fields.start;
+}
+
+uint32_t mpupointer_count(uint32_t word)
+{
+    MPUPointerFields fields;
+
+    (void)mpupointer_unload(word, MPUPOINTER_MOTOROLA, &fields);
+    return fields.count;
+}
+
+int32_t mpupointer_coordinate(uint32_t word, int order,
+                              Coordinate *coordinate_out)
+{
+    MPUPointerFields fields;
+    int32_t status;
+
+    /* Bijection().to_coordinate(self.unload(order).start) */
+    status = mpupointer_unload(word, order, &fields);
+    if (status != SUCCESS) {
+        return status;
+    }
+    bijection_to_coordinate(fields.start, coordinate_out);
+    return SUCCESS;
+}
diff --git a/mm/iscandar/MPUPointer.h b/mm/iscandar/MPUPointer.h
new file mode 100644
index 000000000..7895327e9
--- /dev/null
+++ b/mm/iscandar/MPUPointer.h
@@ -0,0 +1,138 @@
+/* MPUPointer.h -- transcription of MPUPointer.py, the author's
+ * design; the Python is the specification and this code
+ * reproduces it exactly. Transcription only: no original
+ * content.
+ *
+ * A 32-bit virtual address for the MPU, as a bitfield. The
+ * word, in Motorola order (MSB first, the paper's parlance):
+ *
+ *     Virtual   1 bit   top bit: the word belongs to the
+ *                       user's application; it is not to be
+ *                       exposed directly to the microprocessor
+ *                       for decoding
+ *     Reserved  1 bit   not needed today; held against someday
+ *     Start    15 bits  starting sector -- a name: 0..32767
+ *     Count    15 bits  stored shifted: stored + 1 is the true
+ *                       count, so counts run 1..32768, the
+ *                       whole cube is representable, and a
+ *                       zero count is not
+ *
+ * The Intel form declares the same fields from the low end
+ * upward: Virtual at bit 0, Reserved at bit 1, Start at bits
+ * 2..16, stored Count at bits 17..31. Decode order is a code
+ * switch, never a bit in the word: the order argument selects
+ * Motorola (the default) or Intel allocation.
+ *
+ * Every pointer is BORN VIRTUAL (the author's consistency
+ * rule): creation through mpupointer_load always raises the
+ * Virtual flag, the full cube included -- there is no way to
+ * ask load for a flag-down word. A word with the flag down can
+ * only enter by adoption, mpupointer_adopt, as an existing
+ * word read from somewhere -- never by creation.
+ *
+ * Refusals: the Python raises ValueError for every field or
+ * word outside its range, and never masks or truncates
+ * silently, because a reliable pointer cannot be built by
+ * quietly changing the caller's numbers. The C returns a
+ * status instead: one per-site code per distinct refusal
+ * site, named in Status.py (POINTER_ADOPT_WORD_FAIL,
+ * POINTER_LOAD_RESERVED_FAIL, POINTER_LOAD_START_FAIL,
+ * POINTER_LOAD_COUNT_FAIL, POINTER_LOAD_ORDER_FAIL,
+ * POINTER_UNLOAD_ORDER_FAIL; added 2026-11-10, superseding
+ * the foundation tranche's generic FAIL at these sites). On
+ * a refusal the output is not written, in the check-then-set
+ * spirit of the commit path: a refused call changes
+ * nothing. */
+
+#ifndef ISCANDAR_MPUPOINTER_H
+#define ISCANDAR_MPUPOINTER_H
+
+#include <stdint.h>
+
+#include "Coordinate.h"
+#include "Geometry.h"
+
+/* The order switch: MPUPointer.MOTOROLA and MPUPointer.INTEL
+ * in the Python. Any other value is refused, as the Python
+ * refuses an unknown order string. */
+#define MPUPOINTER_MOTOROLA 0
+#define MPUPOINTER_INTEL    1
+
+/* MPUPointer.MAX_WORD, MAX_START, MAX_COUNT in the Python:
+ * ARITY ** 3 is the whole cube, 32768 sectors. */
+#define MPUPOINTER_MAX_WORD  0xFFFFFFFFu
+#define MPUPOINTER_MAX_START \
+    (GEOMETRY_ARITY * GEOMETRY_ARITY * GEOMETRY_ARITY - 1)
+#define MPUPOINTER_MAX_COUNT \
+    (GEOMETRY_ARITY * GEOMETRY_ARITY * GEOMETRY_ARITY)
+
+/* The Fields namedtuple of the Python: unload's result, with
+ * the count back in true form (stored + 1). */
+typedef struct {
+    uint32_t virtual;
+    uint32_t reserved;
+    uint32_t start;
+    uint32_t count;
+} MPUPointerFields;
+
+/* MPUPointer(word): adoption of an existing word. The Python
+ * takes an unbounded int and refuses anything outside
+ * 0..MAX_WORD, so the C takes a uint64_t and refuses what a
+ * uint32_t input could not even express. On SUCCESS *word_out
+ * holds the word, unchanged. The refusal is
+ * POINTER_ADOPT_WORD_FAIL. */
+__declspec(dllexport)
+int32_t mpupointer_adopt(uint64_t word, uint32_t *word_out);
+
+/* MPUPointer.load(start, count, reserved=0, order=MOTOROLA):
+ * pack named fields into a word, the Virtual flag raised.
+ * `count` is the true count. Refuses, each with its own
+ * per-site code: reserved not 0 or 1
+ * (POINTER_LOAD_RESERVED_FAIL), start outside 0..MAX_START
+ * (POINTER_LOAD_START_FAIL), count outside 1..MAX_COUNT
+ * (POINTER_LOAD_COUNT_FAIL), unknown order
+ * (POINTER_LOAD_ORDER_FAIL). There is deliberately no
+ * check that start + count fits the cube, because the Python
+ * has none: fields are validated, geometry is not. */
+__declspec(dllexport)
+int32_t mpupointer_load(uint32_t start, uint32_t count,
+                        uint32_t reserved, int order,
+                        uint32_t *word_out);
+
+/* MPUPointer.load_coordinate(coordinate, count, ...): pack
+ * the block beginning at a Coordinate, flag raised. The
+ * coordinate's displacement is load's start, so a coordinate
+ * past the last name is refused by load's start check. */
+__declspec(dllexport)
+int32_t mpupointer_load_coordinate(const Coordinate *coordinate,
+                                   uint32_t count,
+                                   uint32_t reserved, int order,
+                                   uint32_t *word_out);
+
+/* unload(order=MOTOROLA): the word's fields, with the count
+ * back in true form. Any 32-bit word unloads; only an unknown
+ * order is refused (POINTER_UNLOAD_ORDER_FAIL). */
+__declspec(dllexport)
+int32_t mpupointer_unload(uint32_t word, int order,
+                          MPUPointerFields *fields_out);
+
+/* The fields at a glance, Motorola order: the Python
+ * properties virtual, reserved, start, count. Properties
+ * cannot fail, so these return the value directly. */
+__declspec(dllexport)
+uint32_t mpupointer_virtual(uint32_t word);
+__declspec(dllexport)
+uint32_t mpupointer_reserved(uint32_t word);
+__declspec(dllexport)
+uint32_t mpupointer_start(uint32_t word);
+__declspec(dllexport)
+uint32_t mpupointer_count(uint32_t word);
+
+/* coordinate(order=MOTOROLA): the start of this block, as a
+ * Coordinate, through the Bijection. Refuses only an unknown
+ * order. */
+__declspec(dllexport)
+int32_t mpupointer_coordinate(uint32_t word, int order,
+                              Coordinate *coordinate_out);
+
+#endif /* ISCANDAR_MPUPOINTER_H */
diff --git a/mm/iscandar/Makefile b/mm/iscandar/Makefile
new file mode 100644
index 000000000..f4497637d
--- /dev/null
+++ b/mm/iscandar/Makefile
@@ -0,0 +1,41 @@
+# SPDX-License-Identifier: GPL-2.0
+# The Iscandar core and the one engine text (R9). The
+# engine objects are the c-translation and engine
+# repository sources, copied verbatim into this
+# directory at patch application time (see 0001's
+# header in this set's README terms); their only build
+# seam is the declspec prefix header, applied to this
+# directory alone.
+ccflags-y += -include $(srctree)/mm/iscandar/declspec.h
+# The gear bodies are thin exports whose prototypes live
+# in Gears.h, which they do not include; the harness
+# build did not ask, the kernel build does
+# (-Wmissing-prototypes). Force-including the
+# declarations header directory-wide is the seam; the
+# engine text is unmodified (R9).
+ccflags-y += -include $(srctree)/mm/iscandar/Gears.h
+ccflags-y += -I$(src)
+
+obj-y += core.o iscandar_mass.o
+
+# k=4 (c-translation/k4)
+obj-y += Beam.o BeamCoordinate.o CPUPointer.o CubeEngine.o
+# k=3 (c-translation/k3)
+obj-y += Engine.o Modes.o Mode.o Nano.o Tiny.o Small.o \
+	 Large.o Huge.o Cube.o Plane.o Coordinate.o \
+	 Bijection.o MPUPointer.o Nothing.o Error.o
+# the gear bodies (engine repository)
+obj-y += Mark.o Unmark.o Commit.o RowsCheck.o \
+	 PlanesCheck.o PairsRowDriver.o PlaneSmallDriver.o
+
+# The check drivers jump through label tables; some
+# labels are reached only from the tables, which the
+# kernel's warning set reads as unused. The two row
+# and plane drivers also export entry points no header
+# declares (the harness check programs declared them).
+# The text is of record: the warnings stay visible,
+# they are not errors here.
+CFLAGS_RowsCheck.o += -Wno-error=unused-label
+CFLAGS_PlanesCheck.o += -Wno-error=unused-label
+CFLAGS_PairsRowDriver.o += -Wno-error=unused-label -Wno-error=missing-prototypes
+CFLAGS_PlaneSmallDriver.o += -Wno-error=unused-label -Wno-error=missing-prototypes
diff --git a/mm/iscandar/Mark.c b/mm/iscandar/Mark.c
new file mode 100644
index 000000000..385896e12
--- /dev/null
+++ b/mm/iscandar/Mark.c
@@ -0,0 +1,32 @@
+/* These are data structure maintenance routines with no original
+ * content. They were written by command of the author while he
+ * was ill in bed. */
+
+/* Mark.c -- the mark wrapper. Thin export over the shared helper
+ * in Commit.c: mark_sectors calls the helper with the mark
+ * direction. The helper owns the sectors array and the row and
+ * plane counters; the overall counter is kept in Python.
+ *
+ * Settled contract: int32_t mark_sectors(uint32_t *sectors,
+ * uint32_t *count_rows, uint32_t *count_planes, uint32_t start,
+ * uint32_t count) -> status. Success is GEAR_SUCCESS. The only
+ * failure is check-then-set, FAIL_OVERLAY. No overrun guard here:
+ * the Python boundary owns that check.
+ *
+ * Q4 settled (experimental): the single-row case takes the
+ * combined-mask branch -- one masked op, no middles. Bodies
+ * written per the author's confirmed detailed design; the
+ * single-row branch remains experimental. */
+
+#include "Commit.h"
+#include "status.h"
+
+__declspec(dllexport) 
+  int32_t mark_sectors (uint32_t *sectors, 
+                        uint32_t *count_rows,
+                        uint32_t *count_planes, uint32_t start,
+                        uint32_t count)
+{
+    return commit_sectors(sectors, count_rows, count_planes,
+                          start, count, COMMIT_MARK);
+}
