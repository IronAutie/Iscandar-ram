@@ -0,0 +1,25 @@
+/* These are data structure maintenance routines with no original
+ * content. They were written by command of the author while he
+ * was ill in bed. */
+
+/* Commit.h -- declaration of the shared commit-path helper.
+ * The helper lives in Commit.c, compiled and linked normally;
+ * Mark.c and Unmark.c call it through this header. Never
+ * #include a .c file. */
+
+#ifndef ISCANDAR_COMMIT_H
+#define ISCANDAR_COMMIT_H
+
+#include <stdint.h>
+
+/* Direction flag for commit_sectors: one template, two
+ * directions. The helper name is proposed; the author may
+ * rename it. */
+#define COMMIT_UNMARK 0
+#define COMMIT_MARK 1
+
+int32_t commit_sectors(uint32_t *sectors, uint32_t *count_rows,
+                       uint32_t *count_planes, uint32_t start,
+                       uint32_t count, int direction);
+
+#endif /* ISCANDAR_COMMIT_H */
diff --git a/mm/iscandar/Coordinate.c b/mm/iscandar/Coordinate.c
new file mode 100644
index 000000000..6820d490a
--- /dev/null
+++ b/mm/iscandar/Coordinate.c
@@ -0,0 +1,28 @@
+/* Coordinate.c -- see Coordinate.h. Transcription of
+ * Coordinate.py; the Python is the specification. */
+
+#include "Coordinate.h"
+
+void coordinate_init(Coordinate *coordinate,
+                     uint32_t sector, uint32_t row, uint32_t plane)
+{
+    coordinate->sector = sector;
+    coordinate->row    = row;
+    coordinate->plane  = plane;
+}
+
+uint32_t coordinate_displacement(const Coordinate *coordinate)
+{
+    /* sector + row * Row.SECTORS_PER_ROW
+     *        + plane * Plane.SECTORS_PER_PLANE */
+    return (coordinate->sector
+            + coordinate->row   * COORDINATE_SECTORS_PER_ROW
+            + coordinate->plane * COORDINATE_SECTORS_PER_PLANE);
+}
+
+int coordinate_equals(const Coordinate *a, const Coordinate *b)
+{
+    return (a->sector == b->sector
+            && a->row    == b->row
+            && a->plane  == b->plane) ? 1 : 0;
+}
diff --git a/mm/iscandar/Coordinate.h b/mm/iscandar/Coordinate.h
new file mode 100644
index 000000000..a43e91fb6
--- /dev/null
+++ b/mm/iscandar/Coordinate.h
@@ -0,0 +1,51 @@
+/* Coordinate.h -- transcription of Coordinate.py, the author's
+ * design; the Python is the specification and this code
+ * reproduces it exactly. Transcription only: no original
+ * content. */
+
+#ifndef ISCANDAR_COORDINATE_H
+#define ISCANDAR_COORDINATE_H
+
+#include <stdint.h>
+
+#include "Geometry.h"
+
+/* Row.SECTORS_PER_ROW and Plane.SECTORS_PER_PLANE in the Python:
+ * the row and plane spans the displacement formula walks. */
+#define COORDINATE_SECTORS_PER_ROW \
+    GEOMETRY_ARITY
+#define COORDINATE_SECTORS_PER_PLANE \
+    (GEOMETRY_ARITY * GEOMETRY_ARITY)
+
+/* class Coordinate: "A lattice coordinate: one sector, in one
+ * row, in one plane." The Python __init__ validates nothing --
+ * it stores the three fields as given -- so this type stores
+ * them as given too. Range discipline lives in the modules
+ * that do validate in the Python (Bijection's arithmetic is
+ * exact for any fields; MPUPointer refuses out-of-range
+ * fields). Fields are unsigned: the engine's coordinates are
+ * never negative. */
+typedef struct {
+    uint32_t sector;
+    uint32_t row;
+    uint32_t plane;
+} Coordinate;
+
+/* Coordinate(sector=..., row=..., plane=...): plain storage,
+ * the Python defaults being 0, 0, 0. */
+__declspec(dllexport)
+void coordinate_init(Coordinate *coordinate,
+                     uint32_t sector, uint32_t row, uint32_t plane);
+
+/* The displacement property: this coordinate as a scalar
+ * address (Axiom IV, Equation 6). Never fails in the Python,
+ * so it returns the value directly. */
+__declspec(dllexport)
+uint32_t coordinate_displacement(const Coordinate *coordinate);
+
+/* __eq__: the field triples compare equal or they do not.
+ * Returns 1 when equal, 0 when not. */
+__declspec(dllexport)
+int coordinate_equals(const Coordinate *a, const Coordinate *b);
+
+#endif /* ISCANDAR_COORDINATE_H */
diff --git a/mm/iscandar/Cube.c b/mm/iscandar/Cube.c
new file mode 100644
index 000000000..bee83df10
--- /dev/null
+++ b/mm/iscandar/Cube.c
@@ -0,0 +1,59 @@
+/* Cube.c -- see Cube.h. Transcription of Cube.py; the
+ * Python is the specification. */
+
+#include "Cube.h"
+
+#include <string.h>
+
+#include "status.h"
+
+void cube_init(Cube *cube)
+{
+    memset(cube->words, 0, sizeof(cube->words));
+}
+
+void cube_init_words(Cube *cube, const uint32_t *words)
+{
+    memcpy(cube->words, words, sizeof(cube->words));
+}
+
+int32_t cube_get_plane(const Cube *cube, uint32_t p,
+                       Plane *out)
+{
+    if (p >= GEOMETRY_ARITY) {
+        return KEYRANGE;
+    }
+    /* The view shares the store: the const cast is the
+     * Python's own arrangement, where a Plane taken from a
+     * Cube reads and writes the cube's words. */
+    plane_init(out, (uint32_t *)cube->words, p);
+    return SUCCESS;
+}
+
+int32_t cube_set_plane(Cube *cube, uint32_t p,
+                       const uint32_t *rows)
+{
+    uint32_t base;
+    uint32_t i;
+
+    if (p >= GEOMETRY_ARITY) {
+        return KEYRANGE;
+    }
+    base = p * GEOMETRY_ARITY;
+    for (i = 0; i < GEOMETRY_ARITY; i++) {
+        cube->words[base + i] = row_new(rows[i]);
+    }
+    return SUCCESS;
+}
+
+uint32_t cube_len(const Cube *cube)
+{
+    (void)cube;
+    return GEOMETRY_ARITY;
+}
+
+int cube_contains(const Cube *cube, uint32_t p)
+{
+    (void)cube;
+    return p < GEOMETRY_ARITY;
+}
diff --git a/mm/iscandar/Cube.h b/mm/iscandar/Cube.h
new file mode 100644
index 000000000..3e7724c43
--- /dev/null
+++ b/mm/iscandar/Cube.h
@@ -0,0 +1,67 @@
+/* Cube.h -- transcription of Cube.py, the author's design;
+ * the Python is the specification and this code reproduces
+ * it exactly. Transcription only: no original content. */
+
+#ifndef ISCANDAR_CUBE_H
+#define ISCANDAR_CUBE_H
+
+#include <stdint.h>
+
+#include "Geometry.h"
+#include "Plane.h"
+#include "Row.h"
+
+/* class Cube: "A view over the whole flat store: 32 planes
+ * x 32 rows." */
+#define CUBE_PLANES_PER_CUBE   GEOMETRY_ARITY
+#define CUBE_ROWS_PER_CUBE \
+    (CUBE_PLANES_PER_CUBE * PLANE_ROWS_PER_PLANE)
+#define CUBE_SECTORS_PER_CUBE \
+    (CUBE_PLANES_PER_CUBE * PLANE_SECTORS_PER_PLANE)
+
+/* The flat store itself: 1024 unsigned 32-bit row words,
+ * index plane * 32 + row, each word holding one row's 32
+ * sector bits. Cube.py's .sectors property is this same
+ * array under the author's name for it, not a copy; the
+ * hand-off to C in the Python is this array's buffer, and
+ * here it is simply the array. */
+typedef struct {
+    uint32_t words[CUBE_ROWS_PER_CUBE];
+} Cube;
+
+/* Cube(words=None): a zeroed store when no words are given
+ * (array("I", [0]) * 1024 in the Python). */
+__declspec(dllexport)
+void cube_init(Cube *cube);
+
+/* Cube(words): seat the view on a caller's store, the
+ * Python's words argument. */
+__declspec(dllexport)
+void cube_init_words(Cube *cube, const uint32_t *words);
+
+/* cube[p]: the Plane view over plane p. The Python raises
+ * IndexError outside 0..31; the boundary conversion is
+ * KEYRANGE, and *out is not seated. */
+__declspec(dllexport)
+int32_t cube_get_plane(const Cube *cube, uint32_t p,
+                       Plane *out);
+
+/* cube[p] = plane: whole-plane assignment, the 32 row
+ * values copied in, each masked through Row. A plane
+ * assignment of other than 32 values is a ValueError in
+ * the Python; the C signature takes exactly 32, so that
+ * refusal has no C shape and the count is not a runtime
+ * question here. KEYRANGE for a bad plane index. */
+__declspec(dllexport)
+int32_t cube_set_plane(Cube *cube, uint32_t p,
+                       const uint32_t *rows);
+
+/* len(cube): always ARITY. */
+__declspec(dllexport)
+uint32_t cube_len(const Cube *cube);
+
+/* p in cube: 1 when 0 <= p < ARITY, else 0. */
+__declspec(dllexport)
+int cube_contains(const Cube *cube, uint32_t p);
+
+#endif /* ISCANDAR_CUBE_H */
diff --git a/mm/iscandar/CubeEngine.c b/mm/iscandar/CubeEngine.c
new file mode 100644
index 000000000..88b3d7aaf
--- /dev/null
+++ b/mm/iscandar/CubeEngine.c
@@ -0,0 +1,103 @@
+/* CubeEngine.c -- the per-cube engine ADAPTER. See
+ * CubeEngine.h for the boundary this file stands behind.
+ *
+ * Each CubeEngine holds one real k=3 C Engine. Allocation is
+ * engine_call; the free path rebuilds the MPUPointer word
+ * from the (start, count) Beam.c hands down (the word
+ * MPUPointer.load_coordinate would mint for that block in
+ * Beam.py's free, reduced to its fields) and calls
+ * engine_unmark with it.
+ *
+ * Status mapping: the k=3 C status.h and K4Status.h both
+ * transcribe the one canonical Status.py, so a status crosses
+ * this boundary by value, unchanged. The statuses the free
+ * path can produce are exactly the K4 subset (GEAR_SUCCESS,
+ * FAIL_OVERLAY, FAIL); the named cases below pin that
+ * correspondence, and any other value (a mode's own failure
+ * on the allocate path, where Beam observes only that no
+ * pointer came back) passes through as the very int the
+ * Python Engine would have returned. */
+
+#include "CubeEngine.h"
+#include "K4Status.h"
+
+#include "MPUPointer.h"
+#include "status.h"
+
+static int32_t cube_engine_map_status(int32_t status)
+{
+    switch (status) {
+    case GEAR_SUCCESS:
+        return K4_GEAR_SUCCESS;
+    case FAIL_OVERLAY:
+        return K4_FAIL_OVERLAY;
+    case FAIL:
+        return K4_FAIL;
+    default:
+        return status;
+    }
+}
+
+void cube_engine_init(CubeEngine *engine)
+{
+    engine_init(&engine->engine);
+    engine->count_overall = 0;
+}
+
+void cube_engine_call(CubeEngine *engine, int32_t request,
+                      CubeEngineResult *out)
+{
+    EngineResult result;
+
+    /* A negative request is out of every mode's table: the
+     * Python Engine returns None via the Nothing fallback,
+     * with no search and no gear interaction. The C
+     * engine_call takes uint32_t and cannot express the
+     * case (see Engine.h), so the adapter answers with the
+     * same shape directly. */
+    if (request < 0) {
+        out->kind = K4_ENGINE_NONE;
+        return;
+    }
+
+    engine_call(&engine->engine, (uint32_t)request, &result);
+    engine->count_overall = engine->engine.count_overall;
+
+    switch (result.outcome) {
+    case ENGINE_OUTCOME_POINTER:
+        out->kind = K4_ENGINE_POINTER;
+        out->start = mpupointer_start(result.word);
+        out->count = mpupointer_count(result.word);
+        break;
+    case ENGINE_OUTCOME_NONE:
+        out->kind = K4_ENGINE_NONE;
+        break;
+    default: /* ENGINE_OUTCOME_STATUS */
+        out->kind = K4_ENGINE_STATUS;
+        out->status = cube_engine_map_status(result.status);
+        break;
+    }
+}
+
+int32_t cube_engine_unmark(CubeEngine *engine, uint32_t start,
+                           uint32_t count)
+{
+    uint32_t word;
+    int32_t status;
+
+    /* Rebuild the pointer word for this block, born virtual
+     * as load_coordinate mints it. A refusal here (a count
+     * of 0, or a start past the last name -- neither can
+     * arise from a CPUPointer Beam.c holds) is the boundary
+     * refusal FAIL, the shape Engine.unmark's own boundary
+     * guard returns. */
+    status = mpupointer_load(start, count, 0, MPUPOINTER_MOTOROLA,
+                             &word);
+    if (status != SUCCESS) {
+        return K4_FAIL;
+    }
+
+    status = engine_unmark(&engine->engine, word);
+    engine->count_overall = engine->engine.count_overall;
+    return cube_engine_map_status(status);
+}
diff --git a/mm/iscandar/CubeEngine.h b/mm/iscandar/CubeEngine.h
new file mode 100644
index 000000000..650e5b763
--- /dev/null
+++ b/mm/iscandar/CubeEngine.h
@@ -0,0 +1,88 @@
+/* CubeEngine.h -- the per-cube engine boundary for Beam.c.
+ *
+ * ==================== REAL ENGINE BOUNDARY ====================
+ * Beam.py drives the k=3 Engine (allocator.py) directly, one
+ * Engine instance per cube. This header declares the minimal
+ * interface Beam needs, and CubeEngine.c supplies an ADAPTER
+ * behind it: each CubeEngine holds one real k=3 C Engine
+ * (iscandar-engine, Engine.h), and the functions below reduce
+ * its three return shapes to the CubeEngineResult Beam.c
+ * observes.
+ *
+ * The adapter keeps the Engine's boundary contract exactly,
+ * since that is what Beam observes:
+ *   - a request larger than the sectors remaining returns a
+ *     FAIL status before any search (Engine.__call__ step 1,
+ *     inside engine_call);
+ *   - a zero request yields no result (the Nothing mode);
+ *   - a negative request yields no result: the Python Engine
+ *     returns None there (the Nothing fallback for an
+ *     out-of-table key), and the C engine_call, which takes
+ *     uint32_t, cannot express the case, so the adapter
+ *     answers it directly, with no engine call and no gear
+ *     interaction, exactly as the Python's None path has none;
+ *   - allocate yields a (start, count) pointer result, a bare
+ *     status, or nothing -- the three shapes Engine.__call__
+ *     can return (MPUPointer, status int, None);
+ *   - unmark returns the k=3 engine's own status for the
+ *     (start, count) block (GEAR_SUCCESS / FAIL_OVERLAY /
+ *     FAIL), mapped value-for-value (see CubeEngine.c).
+ *
+ * Placement inside the cube is the real modes' probe
+ * placement, no longer a stub's first fit. The reference generator
+ * (gen_k4_expected.py) drives the real Python Beam over the
+ * real Python k=3 engine, so the Beam test now compares Beam
+ * plus engine against Beam plus engine.
+ *
+ * INTERFACE CHANGE FROM THE STUB ERA, flagged per the work
+ * order: the function signatures and CubeEngineResult are
+ * unchanged, and Beam.c is unchanged. The CubeEngine struct
+ * changed: the stub's bitmap store is gone, replaced by the
+ * real Engine it adapts, plus the count_overall mirror
+ * Beam.c's scan reads (kept in step by the adapter after
+ * every call and unmark). This header now includes the k=3
+ * engine's Engine.h, so compiling anything that includes
+ * this header needs the engine directory on the include
+ * path (run_k4_c_tests.sh supplies it).
+ * ============================================================= */
+
+#ifndef ISCANDAR_K4_CUBE_ENGINE_H
+#define ISCANDAR_K4_CUBE_ENGINE_H
+
+#include <stdint.h>
+
+#include "Engine.h"
+
+#define K4_SECTORS_PER_CUBE 32768u
+
+/* The three shapes an engine call can return. */
+#define K4_ENGINE_NONE    0  /* Python: None (Nothing mode) */
+#define K4_ENGINE_STATUS  1  /* Python: a bare status int */
+#define K4_ENGINE_POINTER 2  /* Python: an MPUPointer */
+
+typedef struct {
+    int kind;          /* K4_ENGINE_* */
+    int32_t status;    /* valid when kind == K4_ENGINE_STATUS */
+    uint32_t start;    /* valid when kind == K4_ENGINE_POINTER */
+    uint32_t count;    /* valid when kind == K4_ENGINE_POINTER */
+} CubeEngineResult;
+
+typedef struct {
+    Engine engine;           /* the real k=3 C Engine for this cube */
+    uint32_t count_overall;  /* mirror of engine.count_overall,
+                                the field Beam.c's scan reads */
+} CubeEngine;
+
+void cube_engine_init(CubeEngine *engine);
+
+/* Engine.__call__(request), boundary contract as above. */
+void cube_engine_call(CubeEngine *engine, int32_t request,
+                      CubeEngineResult *out);
+
+/* Engine.unmark(pointer) reduced to (start, count): returns
+ * GEAR_SUCCESS, FAIL, or FAIL_OVERLAY (the K4 names for the
+ * same Status.py values). */
+int32_t cube_engine_unmark(CubeEngine *engine, uint32_t start,
+                           uint32_t count);
+
+#endif /* ISCANDAR_K4_CUBE_ENGINE_H */
diff --git a/mm/iscandar/Engine.c b/mm/iscandar/Engine.c
new file mode 100644
index 000000000..b53d03b81
--- /dev/null
+++ b/mm/iscandar/Engine.c
@@ -0,0 +1,239 @@
+/* Engine.c -- see Engine.h. Transcription of
+ * allocator.py; the Python is the specification. */
+
+#include "Engine.h"
+
+#include <string.h>
+
+#include "Coordinate.h"
+#include "Gears.h"
+#include "Modes.h"
+#include "MPUPointer.h"
+#include "status.h"
+
+/* The Engine's own verification gates for the Large/Huge
+ * and Small modes, defined below engine_call. */
+static int large_huge_span_fits(const Engine *engine,
+                                uint32_t plane, uint32_t row,
+                                uint32_t sector, uint32_t request);
+static int small_span_fits(const Engine *engine,
+                           uint32_t plane, uint32_t row,
+                           uint32_t request);
+
+void engine_init(Engine *engine)
+{
+    cube_init(&engine->cube);
+    engine->count_overall = 0;
+    memset(engine->count_planes, 0, sizeof engine->count_planes);
+    memset(engine->count_rows, 0, sizeof engine->count_rows);
+}
+
+int32_t engine_mark(Engine *engine, uint32_t word)
+{
+    uint32_t start = mpupointer_start(word);
+    uint32_t count = mpupointer_count(word);
+    int32_t  status;
+
+    if (start + count > CUBE_SECTORS_PER_CUBE) {
+        return FAIL;
+    }
+    status = mark_sectors(engine->cube.words,
+                          engine->count_rows,
+                          engine->count_planes,
+                          start, count);
+    if (status == GEAR_SUCCESS) {
+        engine->count_overall += count;
+    }
+    return status;
+}
+
+int32_t engine_unmark(Engine *engine, uint32_t word)
+{
+    uint32_t start = mpupointer_start(word);
+    uint32_t count = mpupointer_count(word);
+    int32_t  status;
+
+    if (start + count > CUBE_SECTORS_PER_CUBE) {
+        return FAIL;
+    }
+    status = unmark_sectors(engine->cube.words,
+                            engine->count_rows,
+                            engine->count_planes,
+                            start, count);
+    if (status == GEAR_SUCCESS) {
+        engine->count_overall -= count;
+    }
+    return status;
+}
+
+void engine_call(Engine *engine, uint32_t request,
+                 EngineResult *result)
+{
+    const Mode *mode;
+    ModeCtx     ctx;
+    uint32_t    plane;
+    uint32_t    row;
+    uint32_t    sector;
+    int32_t     status;
+    Coordinate  coordinate;
+    uint32_t    word;
+    int         fits;
+
+    /* Step 1: the admission gate. A request larger than
+     * what remains fails outright, with no mode dispatch
+     * and no sweep. */
+    if (request > CUBE_SECTORS_PER_CUBE - engine->count_overall) {
+        result->outcome = ENGINE_OUTCOME_STATUS;
+        result->status  = FAIL;
+        return;
+    }
+
+    /* Step 2: the dispatch, with the Nothing fallback for
+     * out-of-table requests. Nothing's search returns None
+     * in the Python and the Engine returns it directly, so
+     * the Nothing outcome is recognized here by identity,
+     * before any search runs. */
+    mode = modes_get(request);
+    if (mode == modes_nothing()) {
+        result->outcome = ENGINE_OUTCOME_NONE;
+        return;
+    }
+
+    /* Step 3: the mode's search. */
+    ctx.count_planes  = engine->count_planes;
+    ctx.count_rows    = engine->count_rows;
+    ctx.words         = engine->cube.words;
+    ctx.count_overall = (int64_t)engine->count_overall;
+    status = mode->search(&ctx, request, &plane, &row, &sector);
+
+    /* Step 4: the search's own failure is the failure
+     * returned. */
+    if (status != GEAR_SUCCESS) {
+        result->outcome = ENGINE_OUTCOME_STATUS;
+        result->status  = status;
+        return;
+    }
+
+    /* Post-search verification, spoken for each mode as the
+     * Python speaks it (isinstance order: CubeCheck, then
+     * Large or Huge, then Small, then the rest). The modes
+     * are identified by the table entries a key in their
+     * range returns, which is the same partition isinstance
+     * makes. */
+    if (mode == modes_get(CUBE_SECTORS_PER_CUBE)) {
+        /* CubeCheck: the certification is the overall count
+         * itself -- zero, and the request the whole cube. */
+        fits = request == CUBE_SECTORS_PER_CUBE
+            && engine->count_overall == 0;
+    } else if (mode == modes_get(65) || mode == modes_get(1025)) {
+        /* Large and Huge: the span must fit the cube and
+         * the spanned planes' free total must reach the
+         * request. */
+        fits = large_huge_span_fits(engine, plane, row, sector,
+                                    request);
+    } else if (mode == modes_get(33)) {
+        /* Small: the anchor row's free plus its ancillary's
+         * free together must reach the request; the
+         * ancillary row must exist. */
+        fits = small_span_fits(engine, plane, row, request);
+    } else {
+        /* The rest: the found plane's free and the found
+         * row's free must each reach the request. */
+        fits = (PLANE_SECTORS_PER_PLANE
+                    - engine->count_planes[plane] >= request)
+            && (ROW_SECTORS_PER_ROW
+                    - engine->count_rows[
+                          plane * ROW_SECTORS_PER_ROW + row]
+                    >= request);
+    }
+    if (!fits) {
+        result->outcome = ENGINE_OUTCOME_STATUS;
+        result->status  = FAIL;
+        return;
+    }
+
+    /* Step 5: the Coordinate, fields kept separate -- the
+     * sector is relative to the row found, never folded. */
+    coordinate_init(&coordinate, sector, row, plane);
+
+    /* Step 6: construct the pointer from the Coordinate,
+     * born virtual, then mark first; a failed mark
+     * propagates its status and no pointer is returned.
+     * load_coordinate cannot refuse a coordinate a
+     * successful search produced (its start is in range and
+     * the count is the request), but its status is honored
+     * if it ever did. */
+    status = mpupointer_load_coordinate(&coordinate, request, 0,
+                                        MPUPOINTER_MOTOROLA,
+                                        &word);
+    if (status != SUCCESS) {
+        result->outcome = ENGINE_OUTCOME_STATUS;
+        result->status  = status;
+        return;
+    }
+    status = engine_mark(engine, word);
+    if (status != GEAR_SUCCESS) {
+        result->outcome = ENGINE_OUTCOME_STATUS;
+        result->status  = status;
+        return;
+    }
+
+    /* Step 7: return the pointer. */
+    result->outcome = ENGINE_OUTCOME_POINTER;
+    result->word    = word;
+}
+
+void engine_deallocate(Engine *engine, uint32_t word)
+{
+    (void)engine;
+    (void)word;
+}
+
+/* The Large/Huge verification gate: the Engine's, not a
+ * mode's search step (allocator.py, the Large/Huge branch
+ * of the post-search verification). first_plane is the
+ * span's start plane by construction, so the loop runs
+ * from the found plane. */
+static int large_huge_span_fits(const Engine *engine,
+                                uint32_t plane, uint32_t row,
+                                uint32_t sector, uint32_t request)
+{
+    uint32_t start_global;
+    uint32_t end_global;
+    uint32_t last_plane;
+    uint32_t free_spanned = 0;
+    uint32_t pl;
+
+    start_global = plane * PLANE_SECTORS_PER_PLANE
+                 + row * ROW_SECTORS_PER_ROW + sector;
+    end_global = start_global + request;
+    if (end_global > CUBE_SECTORS_PER_CUBE) {
+        return 0;
+    }
+    last_plane = (end_global - 1) / PLANE_SECTORS_PER_PLANE;
+    for (pl = plane; pl <= last_plane; pl++) {
+        free_spanned += PLANE_SECTORS_PER_PLANE
+                        - engine->count_planes[pl];
+    }
+    return free_spanned >= request;
+}
+
+/* The Small verification gate, likewise the Engine's: the
+ * ancillary row (anchor + 1) must exist, and the pair's
+ * free sum must reach the request. */
+static int small_span_fits(const Engine *engine,
+                           uint32_t plane, uint32_t row,
+                           uint32_t request)
+{
+    uint32_t anchor;
+    uint32_t ancillary;
+
+    anchor    = plane * ROW_SECTORS_PER_ROW + row;
+    ancillary = anchor + 1;
+    if (ancillary > CUBE_ROWS_PER_CUBE - 1) {
+        return 0;
+    }
+    return (ROW_SECTORS_PER_ROW - engine->count_rows[anchor])
+         + (ROW_SECTORS_PER_ROW - engine->count_rows[ancillary])
+         >= request;
+}
diff --git a/mm/iscandar/Engine.h b/mm/iscandar/Engine.h
new file mode 100644
index 000000000..2e3bf4ee0
--- /dev/null
+++ b/mm/iscandar/Engine.h
@@ -0,0 +1,82 @@
+/* Engine.h -- transcription target of allocator.py.
+ *
+ * Engine is the allocator: a Cube (the words store, Cube.h)
+ * plus the three counters Engine.__init__ creates
+ * (count_overall, count_planes, count_rows) and the mode
+ * table. Engine.__call__ dispatches a request through the
+ * table (Modes.h) to the request mode that serves its
+ * size, verifies the found placement against the counters,
+ * mints an MPUPointer on the coordinates, marks the sectors
+ * through the C mark path (Mark.c/Unmark.c over Commit.c --
+ * the same entry the Python reaches through Gears.py), and
+ * returns the pointer word. Engine.mark and Engine.unmark
+ * move sectors directly under a pointer word's start and
+ * count, keeping count_overall in step here, exactly as
+ * the Python keeps it (the C marker owns the sectors and
+ * the row and plane counters; the overall counter is the
+ * caller's, per Mark.c's settled contract).
+ *
+ * Return-shape note: the Python's __call__ returns either
+ * a status int (a failure), None (the Nothing outcome for
+ * request 0 and for out-of-table requests), or an
+ * MPUPointer. engine_call keeps those three outcomes
+ * distinct: ENGINE_OUTCOME_STATUS, ENGINE_OUTCOME_NONE,
+ * ENGINE_OUTCOME_POINTER, with the status or the pointer
+ * word in the caller's EngineResult. Negative Python
+ * requests (which fall through to the Nothing fallback and
+ * return None) have no representation here: engine_call
+ * takes uint32_t, so that case cannot be expressed -- see
+ * the tranche report.
+ */
+
+#ifndef ISCANDAR_ENGINE_H
+#define ISCANDAR_ENGINE_H
+
+#include <stdint.h>
+
+#include "Cube.h"
+
+typedef struct {
+    Cube     cube;                              /* the store */
+    uint32_t count_overall;
+    uint32_t count_planes[CUBE_PLANES_PER_CUBE];
+    uint32_t count_rows[CUBE_ROWS_PER_CUBE];
+} Engine;
+
+enum {
+    ENGINE_OUTCOME_STATUS  = 0,
+    ENGINE_OUTCOME_NONE    = 1,
+    ENGINE_OUTCOME_POINTER = 2
+};
+
+typedef struct {
+    int32_t  outcome; /* one of the ENGINE_OUTCOME_* */
+    int32_t  status;  /* when outcome is STATUS */
+    uint32_t word;    /* the pointer word, when POINTER */
+} EngineResult;
+
+/* engine_init: Engine.__init__ -- a fresh Cube store and
+ * zeroed counters. */
+void engine_init(Engine *engine);
+
+/* engine_mark / engine_unmark: Engine.mark / Engine.unmark.
+ * The pointer is a word; start and count are its fields
+ * (Motorola order, the Python properties' default). FAIL
+ * when start + count would run past the cube; otherwise
+ * the C mark path's status, and on GEAR_SUCCESS the
+ * engine's count_overall moves by count. */
+int32_t engine_mark(Engine *engine, uint32_t word);
+int32_t engine_unmark(Engine *engine, uint32_t word);
+
+/* engine_call: Engine.__call__. Allocates request sectors
+ * and reports the outcome in *result. */
+void engine_call(Engine *engine, uint32_t request,
+                 EngineResult *result);
+
+/* engine_deallocate: Engine.deallocate. The Python method
+ * is an unimplemented stub (its body is a docstring); this
+ * transcription has the same content: nothing. The word
+ * argument mirrors the Python's address parameter. */
+void engine_deallocate(Engine *engine, uint32_t word);
+
+#endif /* ISCANDAR_ENGINE_H */
diff --git a/mm/iscandar/Error.c b/mm/iscandar/Error.c
new file mode 100644
index 000000000..567760157
--- /dev/null
+++ b/mm/iscandar/Error.c
@@ -0,0 +1,24 @@
+/* Error.c -- see Error.h. Transcription of Error.py; the
+ * Python is the specification. */
+
+#include "Error.h"
+
+#include "status.h"
+
+void error_range(uint32_t *lo_out, uint32_t *hi_out)
+{
+    /* range(SECTORS_PER_CUBE): 0 .. SECTORS_PER_CUBE - 1. */
+    *lo_out = 0;
+    *hi_out = (uint32_t)ERROR_SECTORS_PER_CUBE - 1;
+}
+
+int32_t error_search(uint32_t *plane_out, uint32_t *row_out,
+                     uint32_t *sector_out)
+{
+    /* (Status.FAIL, 0, 0, 0): the uniform search shape, so
+     * the breakpoint for a table fault is this return. */
+    *plane_out  = 0;
+    *row_out    = 0;
+    *sector_out = 0;
+    return FAIL;
+}
diff --git a/mm/iscandar/Error.h b/mm/iscandar/Error.h
new file mode 100644
index 000000000..85848ff59
--- /dev/null
+++ b/mm/iscandar/Error.h
@@ -0,0 +1,39 @@
+/* Error.h -- transcription of Error.py, the author's design;
+ * the Python is the specification and this code reproduces it
+ * exactly. Transcription only: no original content. */
+
+#ifndef ISCANDAR_ERROR_H
+#define ISCANDAR_ERROR_H
+
+#include <stdint.h>
+
+#include "Geometry.h"
+
+/* Cube.SECTORS_PER_CUBE in the Python: ARITY ** 3, the whole
+ * cube, 32768 sectors. Error.py takes its range span from
+ * Cube; in this tranche the value is expressed from Geometry,
+ * the constant both are built from. */
+#define ERROR_SECTORS_PER_CUBE \
+    (GEOMETRY_ARITY * GEOMETRY_ARITY * GEOMETRY_ARITY)
+
+/* class Error (Mode): the fill for the decision table, in
+ * case any table entries are missing from fill by other
+ * handlers. A complete table never selects it. Only Error.py's
+ * own definitions are transcribed here; the Mode machinery is
+ * not part of this tranche. */
+
+/* Error.range(): range(Cube.SECTORS_PER_CUBE) -- 0 through
+ * 32767. Reported as the inclusive bounds. */
+__declspec(dllexport)
+void error_range(uint32_t *lo_out, uint32_t *hi_out);
+
+/* Error.search(...): if Error is selected, that is a table
+ * fault, so it fails explicitly, in the uniform search shape
+ * (FAIL, 0, 0, 0), and Engine returns that FAIL with no mark
+ * and no pointer. No sweep. The C writes the three zero
+ * outputs and returns FAIL. */
+__declspec(dllexport)
+int32_t error_search(uint32_t *plane_out, uint32_t *row_out,
+                     uint32_t *sector_out);
+
+#endif /* ISCANDAR_ERROR_H */
diff --git a/mm/iscandar/Gears.h b/mm/iscandar/Gears.h
new file mode 100644
index 000000000..9c13910a9
--- /dev/null
+++ b/mm/iscandar/Gears.h
@@ -0,0 +1,102 @@
+/* Gears.h -- declarations for the C gears the Python reaches
+ * through Gears.py. The gear bodies already live in the
+ * author's C: RowsCheck.c (rows gear), PlanesCheck.c (planes
+ * gear and the rows_row_handler adapter), PairsRowDriver.c
+ * (pairs_row_handler), PlaneSmallDriver.c (planes small
+ * gear), Mark.c and Unmark.c (the commit path). This header
+ * declares them; it defines nothing. It is the C twin of
+ * Gears.py's binding block: same functions, same shapes.
+ *
+ * The gears carry state: the planes gear keeps a sticky
+ * start cursor and the planes small gear a rotate cursor,
+ * both function-local statics in the gear sources. Linking
+ * the author's gear bodies unchanged is what carries that
+ * behavior into this transcription exactly. */
+
+#ifndef ISCANDAR_GEARS_H
+#define ISCANDAR_GEARS_H
+
+#include <stdint.h>
+
+/* The bullet: a mode's trial. Returns GEAR_SUCCESS with
+ * *sector_out set on conviction, or the mode's own failure
+ * code on acquittal. The same typedef the gear sources use. */
+typedef int32_t (*bullet_fn) (uint32_t plane, uint32_t row,
+                              uint32_t request, void *ctx,
+                              uint32_t *sector_out);
+
+/* The row handler: fired at one plane; it receives the item
+ * handler to pass down to the rows gear. */
+typedef int32_t (*row_handler_fn) (const uint32_t *count_rows,
+                                   uint32_t plane,
+                                   uint32_t request,
+                                   bullet_fn item_handler,
+                                   void *ctx,
+                                   uint32_t *sector_out,
+                                   uint32_t *row_out);
+
+/* RowsCheck.c */
+__declspec(dllexport)
+int32_t gear_abi_version (void);
+__declspec(dllexport)
+void rows_gear_bind (bullet_fn bullet, void *ctx);
+__declspec(dllexport)
+int32_t rows_gear (const uint32_t *count_rows, uint32_t plane,
+                   uint32_t request, uint32_t *sector_out,
+                   uint32_t *row_out);
+
+/* PlanesCheck.c */
+__declspec(dllexport)
+int32_t rows_row_handler (const uint32_t *count_rows,
+                          uint32_t plane, uint32_t request,
+                          bullet_fn item_handler, void *ctx,
+                          uint32_t *sector_out,
+                          uint32_t *row_out);
+__declspec(dllexport)
+int32_t planes_gear (const uint32_t *count_planes,
+                     const uint32_t *count_rows, uint32_t request,
+                     row_handler_fn row_handler,
+                     bullet_fn item_handler, void *ctx,
+                     uint32_t *sector_out, uint32_t *row_out,
+                     uint32_t *plane_out);
+
+/* PairsRowDriver.c: the per-plane pair handler the planes
+ * small gear fires. (pairs_gear and pairs_gear_bind are the
+ * standalone global pairs gear; Small.search does not use
+ * them, and neither does this transcription.) */
+__declspec(dllexport)
+int32_t pairs_row_handler (const uint32_t *count_rows,
+                           uint32_t plane, uint32_t request,
+                           bullet_fn item_handler, void *ctx,
+                           uint32_t *sector_of_anchor,
+                           uint32_t *row_out);
+
+/* PlaneSmallDriver.c */
+__declspec(dllexport)
+void planes_small_gear_bind (bullet_fn bullet, void *ctx);
+__declspec(dllexport)
+int32_t planes_small_gear (const uint32_t *count_planes,
+                           const uint32_t *count_rows,
+                           uint32_t request,
+                           uint32_t *sector_of_anchor,
+                           uint32_t *row_out,
+                           uint32_t *plane_out);
+
+/* Mark.c / Unmark.c: the commit path. Success is
+ * GEAR_SUCCESS; the only failure is check-then-set,
+ * FAIL_OVERLAY. The helper owns the sectors array and the
+ * row and plane counters; the overall counter is kept by
+ * the caller (Python today, the C Engine in this
+ * transcription), exactly as Mark.c's own header states.
+ * (Gears.py passes one extra trailing argument, the
+ * overall counter's address, which the C ignores.) */
+__declspec(dllexport)
+int32_t mark_sectors (uint32_t *sectors, uint32_t *count_rows,
+                      uint32_t *count_planes, uint32_t start,
+                      uint32_t count);
+__declspec(dllexport)
+int32_t unmark_sectors (uint32_t *sectors, uint32_t *count_rows,
+                        uint32_t *count_planes, uint32_t start,
+                        uint32_t count);
+
+#endif /* ISCANDAR_GEARS_H */
