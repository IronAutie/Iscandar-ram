diff --git a/mm/iscandar/Beam.c b/mm/iscandar/Beam.c
new file mode 100644
index 000000000..8643d28bc
--- /dev/null
+++ b/mm/iscandar/Beam.c
@@ -0,0 +1,131 @@
+/* Beam.c -- see Beam.h. The control flow follows Beam.py line
+ * for line: allocate's overall gate, the scan's per-engine room
+ * check, the first-acceptance walk with rotation, transform on
+ * acceptance, and free's bookkeeping on GEAR_SUCCESS only. */
+
+#include "Beam.h"
+#include "K4Status.h"
+
+int32_t beam_init(Beam *beam, int32_t cardinality)
+{
+    int32_t i;
+
+    /* Beam.py: cardinality = [cardinality, 1][cardinality <= 0] */
+    if (cardinality <= 0) {
+        cardinality = 1;
+    }
+    if (cardinality > K4_BEAM_MAX_CUBES) {
+        return K4_FAIL;
+    }
+
+    beam->count_overall = 0;
+    beam->cardinality = cardinality;
+    for (i = 0; i < cardinality; i++) {
+        cube_engine_init(&beam->engines[i]);
+    }
+    beam->sectors_supported =
+        (int32_t)K4_SECTORS_PER_CUBE * cardinality;
+    beam->lead = 0;
+    return K4_SUCCESS;
+}
+
+void beam_rotate(Beam *beam)
+{
+    beam->lead = (beam->lead + 1) % beam->cardinality;
+}
+
+/* Beam.scan: offer the request to the lead engine. A lead
+ * engine whose remaining count cannot hold the request is
+ * skipped without a call, exactly as in the Python. */
+static void beam_scan(Beam *beam, int32_t request,
+                      CubeEngineResult *out)
+{
+    CubeEngine *engine = &beam->engines[beam->lead];
+
+    if ((int32_t)K4_SECTORS_PER_CUBE - (int32_t)engine->count_overall
+        < request) {
+        out->kind = K4_ENGINE_NONE;
+        return;
+    }
+
+    cube_engine_call(engine, request, out);
+}
+
+/* Beam.transform: the accepting engine's k=3 pointer, with its
+ * cube, becomes a k=4 CPUPointer. The engine's (start, count)
+ * is the MPUPointer reduced to its fields: its coordinate is
+ * Bijection.to_coordinate(start), and the count joins here,
+ * when the CPUPointer is minted. Creation in this path cannot
+ * fail (cube < 32, displacement < 32768, count in 1..32768);
+ * the status is checked anyway, per doctrine. */
+static int32_t beam_transform(const CubeEngineResult *result,
+                              int32_t cube, CPUPointer *out)
+{
+    BeamCoordinate bc;
+    uint32_t d = result->start;
+    int32_t plane = (int32_t)(d / 1024u);
+    int32_t row = (int32_t)((d % 1024u) / 32u);
+    int32_t sector = (int32_t)(d % 32u);
+
+    beam_coordinate_init(&bc, cube, sector, row, plane);
+    return cpu_pointer_create(&bc, result->count, 0,
+                              K4_ORDER_MOTOROLA, out);
+}
+
+int32_t beam_allocate(Beam *beam, int32_t request, CPUPointer *out)
+{
+    int32_t index;
+
+    if (beam->sectors_supported - beam->count_overall < request) {
+        return K4_FAIL;
+    }
+
+    for (index = 0; index < beam->cardinality; index++) {
+        CubeEngineResult result;
+
+        beam_scan(beam, request, &result);
+
+        if (result.kind == K4_ENGINE_POINTER) {
+            beam->count_overall += request;
+            return beam_transform(&result, beam->lead, out);
+        }
+
+        beam_rotate(beam);
+    }
+
+    return K4_FAIL;
+}
+
+int32_t beam_free(Beam *beam, const CPUPointer *pointer)
+{
+    BeamCoordinate coordinate;
+    K3Coordinate local;
+    int32_t status;
+    uint32_t start;
+    uint32_t count;
+
+    /* pointer.coordinate(): where this block was born. */
+    status = cpu_pointer_coordinate(pointer, K4_ORDER_MOTOROLA,
+                                    &coordinate);
+    if (status != K4_SUCCESS) {
+        return status;
+    }
+    if (coordinate.cube < 0 || coordinate.cube >= beam->cardinality) {
+        return K4_FAIL;
+    }
+
+    /* MPUPointer.load_coordinate(coordinate.k3(), count),
+     * reduced to the (start, count) the unmark consumes. */
+    beam_coordinate_k3(&coordinate, &local);
+    start = (uint32_t)k3_coordinate_displacement(&local);
+    count = cpu_pointer_count(pointer);
+
+    status = cube_engine_unmark(&beam->engines[coordinate.cube],
+                                start, count);
+
+    if (status == K4_GEAR_SUCCESS) {
+        beam->count_overall -= (int32_t)count;
+    }
+
+    return status;
+}
diff --git a/mm/iscandar/Beam.h b/mm/iscandar/Beam.h
new file mode 100644
index 000000000..bd8c56242
--- /dev/null
+++ b/mm/iscandar/Beam.h
@@ -0,0 +1,58 @@
+/* Beam.h -- C transcription of Beam.py.
+ *
+ * A Beam is a line of cube engines under a rotary rule: an
+ * allocation is offered to the lead engine first, then to each
+ * engine in turn as the lead rotates, and the first engine that
+ * accepts serves it. A fit never crosses a cube wall. Beam's own
+ * logic -- the overall gate, the per-engine room check before
+ * scanning, the first-acceptance walk, the count bookkeeping,
+ * and the transform of an accepting engine's k=3 pointer into a
+ * k=4 CPUPointer -- is transcribed in full from Beam.py. The
+ * per-cube engines sit behind the adapter boundary in
+ * CubeEngine.h (one real k=3 C Engine per cube).
+ *
+ * Settled shape: a Beam runs 1 to 32 engines. The Python clamps
+ * a non-positive cardinality to 1; the C does the same, and
+ * refuses a cardinality above 32 with K4_FAIL (the Python would
+ * build that many engines; the settled design caps the beam at
+ * 32, and the C array is sized to the cap).
+ *
+ * Returns: beam_allocate returns K4_SUCCESS with *out written
+ * when an engine accepts, and K4_FAIL where the Python returns
+ * None. beam_free returns the engine's own status, as the
+ * Python does. */
+
+#ifndef ISCANDAR_K4_BEAM_H
+#define ISCANDAR_K4_BEAM_H
+
+#include <stdint.h>
+
+#include "CPUPointer.h"
+#include "CubeEngine.h"
+
+#define K4_BEAM_MAX_CUBES 32
+
+typedef struct {
+    int32_t cardinality;
+    int32_t count_overall;
+    int32_t sectors_supported;
+    int32_t lead;
+    CubeEngine engines[K4_BEAM_MAX_CUBES];
+} Beam;
+
+/* Beam.__init__: cardinality <= 0 becomes 1; above 32 refuses. */
+int32_t beam_init(Beam *beam, int32_t cardinality);
+
+/* Beam.rotate: advance the lead engine, wrapping. */
+void beam_rotate(Beam *beam);
+
+/* Beam.allocate(request). */
+int32_t beam_allocate(Beam *beam, int32_t request, CPUPointer *out);
+
+/* Beam.free(pointer): deallocate in the cube the pointer was
+ * born in. A pointer naming a cube this beam does not run is
+ * K4_FAIL (the Python raises IndexError there; the C doctrine
+ * is a status, never a crash -- see the composition record). */
+int32_t beam_free(Beam *beam, const CPUPointer *pointer);
+
+#endif /* ISCANDAR_K4_BEAM_H */
diff --git a/mm/iscandar/BeamCoordinate.c b/mm/iscandar/BeamCoordinate.c
new file mode 100644
index 000000000..2b47be5bc
--- /dev/null
+++ b/mm/iscandar/BeamCoordinate.c
@@ -0,0 +1,36 @@
+/* BeamCoordinate.c -- see BeamCoordinate.h for the contract. */
+
+#include "BeamCoordinate.h"
+
+void beam_coordinate_init(BeamCoordinate *out, int32_t cube,
+                          int32_t sector, int32_t row, int32_t plane)
+{
+    out->cube = cube;
+    out->sector = sector;
+    out->row = row;
+    out->plane = plane;
+}
+
+void beam_coordinate_k3(const BeamCoordinate *bc, K3Coordinate *out)
+{
+    out->sector = bc->sector;
+    out->row = bc->row;
+    out->plane = bc->plane;
+}
+
+int64_t k3_coordinate_displacement(const K3Coordinate *c)
+{
+    /* Row.SECTORS_PER_ROW = 32, Plane.SECTORS_PER_PLANE = 1024. */
+    return (int64_t)c->sector
+         + (int64_t)c->row * 32
+         + (int64_t)c->plane * 1024;
+}
+
+int beam_coordinate_equal(const BeamCoordinate *a,
+                          const BeamCoordinate *b)
+{
+    return a->cube == b->cube
+        && a->sector == b->sector
+        && a->row == b->row
+        && a->plane == b->plane;
+}
diff --git a/mm/iscandar/BeamCoordinate.h b/mm/iscandar/BeamCoordinate.h
new file mode 100644
index 000000000..3d2a6c16d
--- /dev/null
+++ b/mm/iscandar/BeamCoordinate.h
@@ -0,0 +1,49 @@
+/* BeamCoordinate.h -- C transcription of BeamCoordinate.py.
+ *
+ * A BeamCoordinate is a k=3 Coordinate (sector, row, plane) plus
+ * the cube it lives in. Transcription notes: the Python class
+ * validates nothing -- its constructor stores the four fields as
+ * given, and arithmetic (displacement) is done on the stored
+ * values. The C struct does the same: fields are int32_t, stored
+ * as given, and no function here refuses a value. Range refusal
+ * lives one level up, in CPUPointer creation, exactly as in the
+ * Python, where CPUPointer.__init__ checks the computed start. */
+
+#ifndef ISCANDAR_K4_BEAM_COORDINATE_H
+#define ISCANDAR_K4_BEAM_COORDINATE_H
+
+#include <stdint.h>
+
+/* The k=3 Coordinate a BeamCoordinate rests on (Coordinate.py):
+ * one sector, in one row, in one plane. */
+typedef struct {
+    int32_t sector;
+    int32_t row;
+    int32_t plane;
+} K3Coordinate;
+
+typedef struct {
+    int32_t cube;
+    int32_t sector;
+    int32_t row;
+    int32_t plane;
+} BeamCoordinate;
+
+/* Constructor: stores the fields as given (BeamCoordinate.py). */
+void beam_coordinate_init(BeamCoordinate *out, int32_t cube,
+                          int32_t sector, int32_t row, int32_t plane);
+
+/* BeamCoordinate.k3(): the k=3 coordinate inside this one. */
+void beam_coordinate_k3(const BeamCoordinate *bc, K3Coordinate *out);
+
+/* Coordinate.displacement (Coordinate.py, Axiom IV Eq. 6):
+ * sector + row * 32 + plane * 1024. Computed in 64 bits so the
+ * arithmetic matches Python's unbounded ints for any field
+ * values the struct can hold. */
+int64_t k3_coordinate_displacement(const K3Coordinate *c);
+
+/* BeamCoordinate.__eq__/__hash__ rest on the four fields. */
+int beam_coordinate_equal(const BeamCoordinate *a,
+                          const BeamCoordinate *b);
+
+#endif /* ISCANDAR_K4_BEAM_COORDINATE_H */
diff --git a/mm/iscandar/Bijection.c b/mm/iscandar/Bijection.c
new file mode 100644
index 000000000..970f16367
--- /dev/null
+++ b/mm/iscandar/Bijection.c
@@ -0,0 +1,29 @@
+/* Bijection.c -- see Bijection.h. Transcription of
+ * Bijection.py; the Python is the specification. */
+
+#include "Bijection.h"
+#include "Geometry.h"
+
+void bijection_to_coordinate(uint32_t displacement,
+                             Coordinate *coordinate_out)
+{
+    uint32_t plane;
+    uint32_t rem;
+    uint32_t row;
+    uint32_t sector;
+
+    plane  = displacement / (GEOMETRY_ARITY * GEOMETRY_ARITY);
+    rem    = displacement % (GEOMETRY_ARITY * GEOMETRY_ARITY);
+    row    = rem / GEOMETRY_ARITY;
+    sector = rem % GEOMETRY_ARITY;
+
+    coordinate_out->sector = sector;
+    coordinate_out->row    = row;
+    coordinate_out->plane  = plane;
+}
+
+uint32_t bijection_to_displacement(const Coordinate *coordinate)
+{
+    return ((coordinate->plane * GEOMETRY_ARITY + coordinate->row)
+            * GEOMETRY_ARITY + coordinate->sector);
+}
diff --git a/mm/iscandar/Bijection.h b/mm/iscandar/Bijection.h
new file mode 100644
index 000000000..232cb73cf
--- /dev/null
+++ b/mm/iscandar/Bijection.h
@@ -0,0 +1,37 @@
+/* Bijection.h -- transcription of Bijection.py, the author's
+ * design; the Python is the specification and this code
+ * reproduces it exactly. Transcription only: no original
+ * content. */
+
+#ifndef ISCANDAR_BIJECTION_H
+#define ISCANDAR_BIJECTION_H
+
+#include <stdint.h>
+
+#include "Coordinate.h"
+
+/* class Bijection: "Conversions from paper: displacement <->
+ * coordinate, exactly." Bijection.A in the Python is
+ * Geometry.ARITY; the formulas below walk by it directly.
+ *
+ * The Python validates nothing: both directions are pure
+ * arithmetic (divmod one way, multiply-accumulate the other),
+ * exact for any displacement or fields the words can hold,
+ * including displacements past the cube (32768 -> plane 32).
+ * The C is the same arithmetic in uint32_t, so it agrees with
+ * the Python everywhere the engine operates and everywhere
+ * both can represent the result. Neither function can fail,
+ * so neither returns a status. */
+
+/* to_coordinate(displacement): plane, rem = divmod(d, A*A);
+ * row, sector = divmod(rem, A). */
+__declspec(dllexport)
+void bijection_to_coordinate(uint32_t displacement,
+                             Coordinate *coordinate_out);
+
+/* to_displacement(coordinate):
+ * (plane * A + row) * A + sector. */
+__declspec(dllexport)
+uint32_t bijection_to_displacement(const Coordinate *coordinate);
+
+#endif /* ISCANDAR_BIJECTION_H */
diff --git a/mm/iscandar/CPUPointer.c b/mm/iscandar/CPUPointer.c
new file mode 100644
index 000000000..fb81673fc
--- /dev/null
+++ b/mm/iscandar/CPUPointer.c
@@ -0,0 +1,146 @@
+/* CPUPointer.c -- see CPUPointer.h for the contract.
+ *
+ * The pack/unpack arithmetic below was checked field by field
+ * against the Python's bitstruct formats:
+ *   MOTOROLA 'u1u1p17u30u15' pack(virtual, reserved, start, stored)
+ *   INTEL    'u15u30p17u1u1' pack(stored, start, reserved, virtual)
+ * Both name the same 64 bits; the Intel form reads its fields
+ * from the low end upward. */
+
+#include "CPUPointer.h"
+#include "K4Status.h"
+
+int32_t cpu_pointer_create(const BeamCoordinate *coordinate,
+                           uint32_t count, uint32_t reserved,
+                           int order, CPUPointer *out)
+{
+    K3Coordinate local;
+    int64_t displacement;
+    int64_t start;
+    uint32_t stored;
+
+    if (reserved > 1) {
+        return K4_FAIL;
+    }
+    if (count < 1 || count > K4_CPU_MAX_COUNT) {
+        return K4_FAIL;
+    }
+
+    beam_coordinate_k3(coordinate, &local);
+    displacement = k3_coordinate_displacement(&local);
+    start = (int64_t)coordinate->cube * 32768 + displacement;
+    if (start < 0 || start > (int64_t)K4_CPU_MAX_START) {
+        return K4_FAIL;
+    }
+
+    stored = count - 1;
+    if (order == K4_ORDER_INTEL) {
+        out->word = ((uint64_t)stored << 49)
+                  | ((uint64_t)(uint32_t)start << 19)
+                  | ((uint64_t)reserved << 1)
+                  | 1u;  /* virtual: born virtual, always */
+    } else if (order == K4_ORDER_MOTOROLA) {
+        out->word = (1ull << 63)  /* virtual: born virtual */
+                  | ((uint64_t)reserved << 62)
+                  | ((uint64_t)(uint32_t)start << 15)
+                  | (uint64_t)stored;
+    } else {
+        return K4_FAIL;
+    }
+    return K4_SUCCESS;
+}
+
+int32_t cpu_pointer_adopt(uint64_t word, CPUPointer *out)
+{
+    out->word = word;
+    return K4_SUCCESS;
+}
+
+int32_t cpu_pointer_unload(const CPUPointer *p, int order,
+                           CPUPointerFields *out)
+{
+    uint64_t w = p->word;
+    uint32_t stored;
+
+    if (order == K4_ORDER_INTEL) {
+        stored = (uint32_t)(w >> 49);
+        out->start = (uint32_t)((w >> 19) & 0x3FFFFFFFull);
+        out->reserved_bit = (uint32_t)((w >> 1) & 1u);
+        out->virtual_bit = (uint32_t)(w & 1u);
+    } else if (order == K4_ORDER_MOTOROLA) {
+        out->virtual_bit = (uint32_t)(w >> 63);
+        out->reserved_bit = (uint32_t)((w >> 62) & 1u);
+        out->start = (uint32_t)((w >> 15) & 0x3FFFFFFFull);
+        stored = (uint32_t)(w & 0x7FFFull);
+    } else {
+        return K4_FAIL;
+    }
+    out->count = stored + 1;
+    return K4_SUCCESS;
+}
+
+uint32_t cpu_pointer_virtual(const CPUPointer *p)
+{
+    CPUPointerFields f;
+    (void)cpu_pointer_unload(p, K4_ORDER_MOTOROLA, &f);
+    return f.virtual_bit;
+}
+
+uint32_t cpu_pointer_reserved(const CPUPointer *p)
+{
+    CPUPointerFields f;
+    (void)cpu_pointer_unload(p, K4_ORDER_MOTOROLA, &f);
+    return f.reserved_bit;
+}
+
+uint32_t cpu_pointer_start(const CPUPointer *p)
+{
+    CPUPointerFields f;
+    (void)cpu_pointer_unload(p, K4_ORDER_MOTOROLA, &f);
+    return f.start;
+}
+
+uint32_t cpu_pointer_count(const CPUPointer *p)
+{
+    CPUPointerFields f;
+    (void)cpu_pointer_unload(p, K4_ORDER_MOTOROLA, &f);
+    return f.count;
+}
+
+int32_t cpu_pointer_coordinate(const CPUPointer *p, int order,
+                               BeamCoordinate *out)
+{
+    CPUPointerFields f;
+    int32_t status;
+    uint32_t local;
+    int32_t cube;
+    int32_t plane;
+    int32_t row;
+    int32_t sector;
+
+    status = cpu_pointer_unload(p, order, &f);
+    if (status != K4_SUCCESS) {
+        return status;
+    }
+
+    /* Bijection.to_coordinate on the local displacement:
+     * plane = d / 1024, row = (d % 1024) / 32, sector = d % 32. */
+    cube = (int32_t)(f.start / 32768u);
+    local = f.start % 32768u;
+    plane = (int32_t)(local / 1024u);
+    row = (int32_t)((local % 1024u) / 32u);
+    sector = (int32_t)(local % 32u);
+
+    beam_coordinate_init(out, cube, sector, row, plane);
+    return K4_SUCCESS;
+}
+
+uint64_t cpu_pointer_word(const CPUPointer *p)
+{
+    return p->word;
+}
+
+int cpu_pointer_equal(const CPUPointer *a, const CPUPointer *b)
+{
+    return a->word == b->word;
+}
diff --git a/mm/iscandar/CPUPointer.h b/mm/iscandar/CPUPointer.h
new file mode 100644
index 000000000..f0f4e069f
--- /dev/null
+++ b/mm/iscandar/CPUPointer.h
@@ -0,0 +1,89 @@
+/* CPUPointer.h -- C transcription of CPUPointer.py.
+ *
+ * A CPUPointer is a standalone 64-bit word (not an int subclass
+ * in C: a struct holding the word, nothing else). The layout,
+ * settled at k=4 and matching the Python's bitstruct formats:
+ *
+ *   Motorola order (the paper's parlance, MSB first):
+ *     V(1) R(1) pad(17) start(30) stored(15)
+ *     word = V<<63 | R<<62 | start<<15 | stored
+ *   Intel order (the same fields declared from the low end):
+ *     stored(15) start(30) pad(17) R(1) V(1)
+ *     word = stored<<49 | start<<19 | R<<1 | V
+ *
+ * start is cube over local: start = cube * 32768 + displacement,
+ * so its high 15 bits name the cube and its low 15 the sector
+ * inside the cube. stored is the true count minus 1, so counts
+ * run 1..32768 and the whole cube is representable.
+ *
+ * A pointer is born two ways only, as in the Python: creation
+ * (cpu_pointer_create), which always raises the Virtual flag,
+ * and adoption (cpu_pointer_adopt), which takes an existing word
+ * as it lies. Validation refuses, never masks: a field outside
+ * its range is a K4_FAIL status, and nothing is silently
+ * truncated. Every fallible function returns an int32_t status;
+ * nothing here crashes or aborts. */
+
+#ifndef ISCANDAR_K4_CPU_POINTER_H
+#define ISCANDAR_K4_CPU_POINTER_H
+
+#include <stdint.h>
+
+#include "BeamCoordinate.h"
+
+/* Decode order, a code switch, never a bit in the word
+ * (MPUPointer.py: MOTOROLA / INTEL). */
+#define K4_ORDER_MOTOROLA 0
+#define K4_ORDER_INTEL    1
+
+#define K4_CPU_MAX_START  ((1u << 30) - 1)  /* CPUPointer.MAX_START */
+#define K4_CPU_MAX_COUNT  32768u            /* Cube.SECTORS_PER_CUBE */
+
+typedef struct {
+    uint64_t word;
+} CPUPointer;
+
+/* CPUPointer.Fields: the unloaded word, count in true form. */
+typedef struct {
+    uint32_t virtual_bit;
+    uint32_t reserved_bit;
+    uint32_t start;
+    uint32_t count;
+} CPUPointerFields;
+
+/* Creation: a BeamCoordinate and a count go in, the word is
+ * born, Virtual raised. reserved must be 0 or 1, count must be
+ * 1..32768, and the computed start must be 0..2^30-1; any
+ * violation, or an unknown order, is K4_FAIL and *out is not
+ * written. */
+int32_t cpu_pointer_create(const BeamCoordinate *coordinate,
+                           uint32_t count, uint32_t reserved,
+                           int order, CPUPointer *out);
+
+/* Adoption: an existing word enters as it is, flag as it lies.
+ * Any 64-bit word is adoptable, so this cannot fail. */
+int32_t cpu_pointer_adopt(uint64_t word, CPUPointer *out);
+
+/* unload(order): the word's fields, count back in true form.
+ * An unknown order is K4_FAIL. */
+int32_t cpu_pointer_unload(const CPUPointer *p, int order,
+                           CPUPointerFields *out);
+
+/* The fields at a glance, Motorola order (the Python
+ * properties). Infallible: Motorola unload always succeeds. */
+uint32_t cpu_pointer_virtual(const CPUPointer *p);
+uint32_t cpu_pointer_reserved(const CPUPointer *p);
+uint32_t cpu_pointer_start(const CPUPointer *p);
+uint32_t cpu_pointer_count(const CPUPointer *p);
+
+/* coordinate(order): the start of this block, as a
+ * BeamCoordinate (via Bijection.to_coordinate on the local
+ * displacement). An unknown order is K4_FAIL. */
+int32_t cpu_pointer_coordinate(const CPUPointer *p, int order,
+                               BeamCoordinate *out);
+
+/* __int__ and __eq__. */
+uint64_t cpu_pointer_word(const CPUPointer *p);
+int cpu_pointer_equal(const CPUPointer *a, const CPUPointer *b);
+
+#endif /* ISCANDAR_K4_CPU_POINTER_H */
diff --git a/mm/iscandar/Commit.c b/mm/iscandar/Commit.c
new file mode 100644
index 000000000..2b1c1720a
--- /dev/null
+++ b/mm/iscandar/Commit.c
@@ -0,0 +1,218 @@
+/* These are data structure maintenance routines with no original
+ * content. They were written by command of the author while he
+ * was ill in bed. */
+
+/* Commit.c -- the shared commit-path helper (proposed name; the
+ * author may rename it). One template, with a direction flag:
+ * mark one way, unmark the other. Mark.c and Unmark.c are thin
+ * wrappers over it. It lives as its own .c file, compiled and
+ * linked normally -- no .c file is ever included.
+ *
+ * Settled shape: start S, count L, end E = S + L - 1; first and
+ * last row by division by 32, first and last plane by division by
+ * 1024. First edge row and last edge row take one masked word op
+ * each (OR to mark, AND with the complement to unmark) plus a
+ * partial counter add or subtract. Middle rows go by a single
+ * memset over the range (0xFF / 0x00), their counters assigned
+ * 32 / 0; middle planes assigned 1024 / 0. Edge planes move by
+ * arithmetic: edge partials plus 32 per middle row inside the
+ * plane. Check-then-set guards every flip: edge words on their
+ * bits, middle ranges on their counters. Any check that fails
+ * returns FAIL_OVERLAY and flips nothing.
+ *
+ * Q4 settled (experimental): the single-row case takes the
+ * combined-mask branch -- one masked op, no middles. Bodies
+ * written per the author's confirmed detailed design; the
+ * single-row branch remains experimental. */
+
+#include "Commit.h"
+#include "status.h"
+
+#include <string.h>
+
+int32_t commit_sectors(uint32_t *sectors, uint32_t *count_rows,
+                       uint32_t *count_planes, uint32_t start,
+                       uint32_t count, int direction)
+{
+    uint32_t s;
+    uint32_t e;
+    uint32_t first_row;
+    uint32_t last_row;
+    uint32_t first_plane;
+    uint32_t last_plane;
+    uint32_t first_mask;
+    uint32_t last_mask;
+    uint32_t mask;
+    uint32_t first_partial;
+    uint32_t last_partial;
+    uint32_t middle_in_first;
+    uint32_t middle_in_last;
+    uint32_t middle_in_plane;
+    uint32_t r;
+    uint32_t p;
+    int is_mark;
+
+    /* Caller error, not an overlay: nothing to mark or unmark. */
+    if (count == 0) {
+        return FAIL;
+    }
+
+    is_mark = (direction == COMMIT_MARK);
+
+    s = start;
+    e = s + count - 1;
+    first_row = s / 32;
+    last_row = e / 32;
+    first_plane = first_row / 32;
+    last_plane = last_row / 32;
+
+    /* Masks in sector order: sector s is bit s, so a word mask
+     * uses 1u << s. Positions are never mirrored into sectors.
+     * Shifting by 32 is undefined, so the last-edge mask is built
+     * with a guard for the full-row case. */
+    first_mask = 0xFFFFFFFFu << (s % 32);
+    if ((e % 32) == 31) {
+        last_mask = 0xFFFFFFFFu;
+    } else {
+        last_mask = (1u << ((e % 32) + 1)) - 1;
+    }
+
+    /* Single-row case (Q4, experimental): one masked op, no
+     * middles. The combined mask is the intersection of the two
+     * edge masks in that row. Its contribution to the counters
+     * is L. */
+    if (first_row == last_row) {
+        mask = first_mask & last_mask;
+        if (is_mark) {
+            if ((sectors[first_row] & mask) != 0) {
+                return FAIL_OVERLAY;
+            }
+        } else {
+            if ((sectors[first_row] & mask) != mask) {
+                return FAIL_OVERLAY;
+            }
+        }
+        if (is_mark) {
+            sectors[first_row] |= mask;
+            count_rows[first_row] += count;
+            count_planes[first_plane] += count;
+        } else {
+            sectors[first_row] &= ~mask;
+            count_rows[first_row] -= count;
+            count_planes[first_plane] -= count;
+        }
+        return GEAR_SUCCESS;
+    }
+
+    first_partial = 32 - (s % 32);
+    last_partial = (e % 32) + 1;
+
+    /* Phase 1: validate everything. Nothing flips below unless
+     * every check here passes, so a failure changes no word and
+     * no counter at all. */
+    /* Edge words, on their bits. */
+    if (is_mark) {
+        if ((sectors[first_row] & first_mask) != 0) {
+            return FAIL_OVERLAY;
+        }
+        if ((sectors[last_row] & last_mask) != 0) {
+            return FAIL_OVERLAY;
+        }
+    } else {
+        if ((sectors[first_row] & first_mask) != first_mask) {
+            return FAIL_OVERLAY;
+        }
+        if ((sectors[last_row] & last_mask) != last_mask) {
+            return FAIL_OVERLAY;
+        }
+    }
+    /* Middle rows, on their counters: no bit-scan before a bulk
+     * fill, per the confirmed design. A middle row about to be
+     * filled must be entirely free (mark) or entirely occupied
+     * (unmark), and its counter says so. */
+    for (r = first_row + 1; r < last_row; r++) {
+        if (is_mark) {
+            if (count_rows[r] != 0) {
+                return FAIL_OVERLAY;
+            }
+        } else {
+            if (count_rows[r] != 32) {
+                return FAIL_OVERLAY;
+            }
+        }
+    }
+    /* Middle planes, on their counters, likewise. */
+    for (p = first_plane + 1; p < last_plane; p++) {
+        if (is_mark) {
+            if (count_planes[p] != 0) {
+                return FAIL_OVERLAY;
+            }
+        } else {
+            if (count_planes[p] != 1024) {
+                return FAIL_OVERLAY;
+            }
+        }
+    }
+
+    /* Phase 2: commit. Edge rows first: one masked word op each,
+     * plus a partial counter move. */
+    if (is_mark) {
+        sectors[first_row] |= first_mask;
+        count_rows[first_row] += first_partial;
+        sectors[last_row] |= last_mask;
+        count_rows[last_row] += last_partial;
+    } else {
+        sectors[first_row] &= ~first_mask;
+        count_rows[first_row] -= first_partial;
+        sectors[last_row] &= ~last_mask;
+        count_rows[last_row] -= last_partial;
+    }
+
+    /* Middle rows: one memset over the contiguous range, then
+     * assign their counters (memset cannot express 32 in a
+     * uint32 array, so the counters go by a bounded loop). */
+    if (last_row > first_row + 1) {
+        memset(&sectors[first_row + 1],
+               is_mark ? 0xFF : 0x00,
+               (size_t)(last_row - first_row - 1) * sizeof(uint32_t));
+        for (r = first_row + 1; r < last_row; r++) {
+            count_rows[r] = is_mark ? 32 : 0;
+        }
+    }
+
+    /* Planes: middle planes assigned whole; edge planes move by
+     * arithmetic (edge partials plus 32 per middle row inside
+     * the plane). */
+    if (first_plane != last_plane) {
+        middle_in_first = 31 - (first_row % 32);
+        middle_in_last = last_row % 32;
+        for (p = first_plane + 1; p < last_plane; p++) {
+            count_planes[p] = is_mark ? 1024 : 0;
+        }
+        if (is_mark) {
+            count_planes[first_plane] += first_partial
+                                       + 32 * middle_in_first;
+            count_planes[last_plane] += last_partial
+                                      + 32 * middle_in_last;
+        } else {
+            count_planes[first_plane] -= first_partial
+                                       + 32 * middle_in_first;
+            count_planes[last_plane] -= last_partial
+                                      + 32 * middle_in_last;
+        }
+    } else {
+        middle_in_plane = 0;
+        if (last_row > first_row + 1) {
+            middle_in_plane = last_row - first_row - 1;
+        }
+        if (is_mark) {
+            count_planes[first_plane] += first_partial + last_partial
+                                       + 32 * middle_in_plane;
+        } else {
+            count_planes[first_plane] -= first_partial + last_partial
+                                       + 32 * middle_in_plane;
+        }
+    }
+
+    return GEAR_SUCCESS;
+}
diff --git a/mm/iscandar/Commit.h b/mm/iscandar/Commit.h
new file mode 100644
