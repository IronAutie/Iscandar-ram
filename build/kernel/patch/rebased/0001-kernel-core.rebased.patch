+    remaining = SECTORS_PER_ROW - count_rows [at];
+    if (request > remaining) goto row_30;
+    status = handler_callback (plane, row, request, handler_ctx, sector_out);
+    if (status != GEAR_SUCCESS) goto row_30;
+    *row_out = row;
+    return GEAR_SUCCESS;
+
+row_30:
+    row       = 30;
+    at        = base + row;
+    remaining = SECTORS_PER_ROW - count_rows [at];
+    if (request > remaining) goto row_31;
+    status = handler_callback (plane, row, request, handler_ctx, sector_out);
+    if (status != GEAR_SUCCESS) goto row_31;
+    *row_out = row;
+    return GEAR_SUCCESS;
+
+row_31:
+    row       = 31;
+    at        = base + row;
+    remaining = SECTORS_PER_ROW - count_rows [at];
+    if (request > remaining) goto exhaust;
+    status = handler_callback (plane, row, request, handler_ctx, sector_out);
+    if (status != GEAR_SUCCESS) goto exhaust;
+    *row_out = row;
+    return GEAR_SUCCESS;
+
+exhaust:
+    return GEAR_EXHAUST;
+}
diff --git a/mm/iscandar/Small.c b/mm/iscandar/Small.c
new file mode 100644
index 000000000..d7e4d737e
--- /dev/null
+++ b/mm/iscandar/Small.c
@@ -0,0 +1,99 @@
+/* Small.c -- see Small.h. Transcription of Small.py; the
+ * Python is the specification. */
+
+#include "Small.h"
+
+#include "Gears.h"
+#include "Geometry.h"
+#include "Row.h"
+#include "status.h"
+
+void small_range(uint32_t *lo_out, uint32_t *hi_out)
+{
+    *lo_out = ROW_SECTORS_PER_ROW + 1;
+    *hi_out = ROW_SECTORS_TWEEN_ROWS;
+}
+
+int32_t small_bullet(uint32_t plane, uint32_t row,
+                     uint32_t request, void *ctx,
+                     uint32_t *sector_of_anchor)
+{
+    const uint32_t *words = (const uint32_t *)ctx;
+    uint32_t global_row;
+    uint32_t anchor;
+    uint32_t ancillary;
+    uint32_t tail_len;
+    uint32_t head_len;
+    uint32_t sector;
+
+    /* Global row 1023 has no later row, so it cannot be an
+     * anchor. Out-of-domain length fails the same way. */
+    global_row = plane * GEOMETRY_ARITY + row;
+    if (global_row > 1022) {
+        return SMALL_FAIL;
+    }
+    if (request < ROW_SECTORS_PER_ROW + 1
+            || request > ROW_SECTORS_TWEEN_ROWS) {
+        return SMALL_FAIL;
+    }
+
+    anchor    = words[global_row];
+    ancillary = words[global_row + 1];
+
+    /* P: anchor tail run ending at sector 31. P = 0 means
+     * the anchor does not reach the row edge, so this pair
+     * cannot join, however much free space the pair holds
+     * elsewhere. Edge-join only is the semantic intent. */
+    tail_len = 0;
+    for (sector = 32; sector-- > 0; ) {
+        if (((anchor >> sector) & 1u) == 0) {
+            tail_len += 1;
+        } else {
+            break;
+        }
+    }
+
+    /* Q: ancillary head run starting at sector 0. Q = 0
+     * means the ancillary does not start at the row edge,
+     * so this pair cannot join. */
+    head_len = 0;
+    for (sector = 0; sector < 32; sector++) {
+        if (((ancillary >> sector) & 1u) == 0) {
+            head_len += 1;
+        } else {
+            break;
+        }
+    }
+
+    /* Logical pair certification, not a free-sum gate:
+     * both edges must be present, and together they must
+     * reach the request. */
+    if (tail_len < 1 || head_len < 1) {
+        return SMALL_FAIL;
+    }
+    if (tail_len + head_len < request) {
+        return SMALL_FAIL;
+    }
+
+    /* Conviction: start at the anchor tail's start, so the
+     * block runs forward from there into the ancillary
+     * head. */
+    *sector_of_anchor = 32 - tail_len;
+    return GEAR_SUCCESS;
+}
+
+int32_t small_search(uint32_t request,
+                     const uint32_t *count_planes,
+                     const uint32_t *count_rows,
+                     const uint32_t *words,
+                     uint32_t *plane_out, uint32_t *row_out,
+                     uint32_t *sector_out)
+{
+    /* Gears.scan_small: bind once, then the gear. The ctx
+     * handed to the bullet is the words array, as the
+     * Python's bullet closure supplies it. */
+    planes_small_gear_bind(small_bullet, (void *)words);
+    return planes_small_gear(count_planes, count_rows,
+                             request, sector_out, row_out,
+                             plane_out);
+}
diff --git a/mm/iscandar/Small.h b/mm/iscandar/Small.h
new file mode 100644
index 000000000..eceace8ca
--- /dev/null
+++ b/mm/iscandar/Small.h
@@ -0,0 +1,49 @@
+/* Small.h -- transcription of Small.py, the author's
+ * design; the Python is the specification and this code
+ * reproduces it exactly. Transcription only: no original
+ * content. */
+
+#ifndef ISCANDAR_SMALL_H
+#define ISCANDAR_SMALL_H
+
+#include <stdint.h>
+
+/* class Small (Mode): "handles between rows requests" --
+ * the request mode for 33..64 sectors, dispatched by the
+ * Modes table. Its search runs the separate planes small
+ * gear (PlaneSmallDriver.c), not the standard planes-over-
+ * rows pattern, exactly as Small.search calls
+ * Gears.scan_small in the Python. */
+
+/* Small.range(): inclusive(SECTORS_PER_ROW + 1,
+ * SECTORS_TWEEN_ROWS) -- 33..64. Reported as the inclusive
+ * bounds. */
+__declspec(dllexport)
+void small_range(uint32_t *lo_out, uint32_t *hi_out);
+
+/* The bullet: probe a pair of rows. The anchor is the
+ * earlier row of the pair, the ancillary simply the next
+ * word in ctx, even across a plane boundary; global row
+ * 1023 has no later row and cannot be an anchor. ctx is
+ * the sectors words array; *sector_of_anchor takes the
+ * placement's start sector within the anchor row on
+ * conviction (GEAR_SUCCESS). Acquittal is SMALL_FAIL.
+ * The probe never marks. */
+__declspec(dllexport)
+int32_t small_bullet(uint32_t plane, uint32_t row,
+                     uint32_t request, void *ctx,
+                     uint32_t *sector_of_anchor);
+
+/* Small.search: bind the bullet and fire the planes small
+ * gear once. The return is the raw gear outcome: the
+ * status, and on GEAR_SUCCESS the plane, row, and sector
+ * of the conviction. */
+__declspec(dllexport)
+int32_t small_search(uint32_t request,
+                     const uint32_t *count_planes,
+                     const uint32_t *count_rows,
+                     const uint32_t *words,
+                     uint32_t *plane_out, uint32_t *row_out,
+                     uint32_t *sector_out);
+
+#endif /* ISCANDAR_SMALL_H */
diff --git a/mm/iscandar/Tiny.c b/mm/iscandar/Tiny.c
new file mode 100644
index 000000000..1638c8598
--- /dev/null
+++ b/mm/iscandar/Tiny.c
@@ -0,0 +1,101 @@
+/* Tiny.c -- see Tiny.h. Transcription of Tiny.py; the
+ * Python is the specification. */
+
+#include "Tiny.h"
+
+#include "Geometry.h"
+#include "Row.h"
+#include "status.h"
+
+void tiny_range(uint32_t *lo_out, uint32_t *hi_out)
+{
+    *lo_out = GEOMETRY_SECTORS_PER_BYTE + 1;
+    *hi_out = ROW_SECTORS_PER_ROW;
+}
+
+int32_t tiny_bullet(uint32_t plane, uint32_t row,
+                    uint32_t request, void *ctx,
+                    uint32_t *sector_out)
+{
+    const uint32_t *words = (const uint32_t *)ctx;
+    uint32_t global_row;
+    uint32_t s;
+    int32_t  run_start;
+    uint32_t run_len;
+    int      left_found;
+    uint32_t left_start;
+    uint32_t left_len;
+    uint32_t sector;
+    uint32_t tail_len;
+
+    /* Boundary check, as in Listing 18: GlobalRow past
+     * 1023 fails. Out-of-domain length fails the same way. */
+    global_row = plane * GEOMETRY_ARITY + row;
+    if (global_row > 1023) {
+        return TINY_FAIL;
+    }
+    if (request < GEOMETRY_SECTORS_PER_BYTE + 1
+            || request > ROW_SECTORS_PER_ROW) {
+        return TINY_FAIL;
+    }
+
+    s = words[global_row];
+
+    /* Left pass (sector package): scan sectors 0 toward 31;
+     * the first (lowest-start) clear run of at least 9
+     * sectors wins. Runs under 9 are skipped: 8-runs are
+     * not eligible, strict separation of modes (Nano owns
+     * 1..8). The sentinel at 32 flushes a run ending at
+     * sector 31. */
+    run_start  = -1;
+    run_len    = 0;
+    left_found = 0;
+    left_start = 0;
+    left_len   = 0;
+    for (sector = 0; sector < 33; sector++) {
+        if (sector < 32 && ((s >> sector) & 1u) == 0) {
+            if (run_len == 0) {
+                run_start = (int32_t)sector;
+            }
+            run_len += 1;
+        } else {
+            if (run_len >= 9) {
+                left_found = 1;
+                left_start = (uint32_t)run_start;
+                left_len   = run_len;
+                break;
+            }
+            run_len = 0;
+        }
+    }
+    if (left_found && left_len >= request) {
+        /* Place at the run's start: its lowest sectors.
+         * This holds even when the revealed run happens to
+         * be a tail run (pass scoping: Left always places
+         * low-side; only the Right pass places ending at
+         * sector 31). */
+        *sector_out = left_start;
+        return GEAR_SUCCESS;
+    }
+    /* Eligible but short, or none: second bite. */
+
+    /* Right pass (second bite): tail run ending at sector
+     * 31. */
+    tail_len = 0;
+    for (sector = 32; sector-- > 0; ) {
+        if (((s >> sector) & 1u) == 0) {
+            tail_len += 1;
+        } else {
+            break;
+        }
+    }
+    if (tail_len >= request) {
+        /* Place the requested run ending at sector 31. The
+         * leftover, if the tail run was longer, becomes an
+         * interior gap. */
+        *sector_out = 32 - request;
+        return GEAR_SUCCESS;
+    }
+
+    return TINY_FAIL;
+}
diff --git a/mm/iscandar/Tiny.h b/mm/iscandar/Tiny.h
new file mode 100644
index 000000000..4d3ddb443
