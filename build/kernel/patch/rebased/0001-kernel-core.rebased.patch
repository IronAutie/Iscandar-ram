+/* Mode.c -- see Mode.h. Transcription of Mode.py; the
+ * Python is the specification. */
+
+#include "Mode.h"
+
+#include "Cube.h"
+#include "Plane.h"
+
+int mode_has_keying(const Mode *mode, uint32_t key)
+{
+    return key >= mode->lo && key < mode->hi;
+}
+
+int32_t mode_base_search(const ModeCtx *ctx, uint32_t request,
+                         bullet_fn bullet,
+                         uint32_t *plane_out, uint32_t *row_out,
+                         uint32_t *sector_out)
+{
+    /* Mode.search: Gears.scan(count_planes, count_rows,
+     * request, self.bullet) -- the planes gear with the
+     * rows row handler, the bullet's ctx the words array,
+     * exactly as Gears.scan wires it in Gears.py. */
+    return planes_gear(ctx->count_planes, ctx->count_rows,
+                       request, rows_row_handler, bullet,
+                       (void *)ctx->words, sector_out, row_out,
+                       plane_out);
+}
diff --git a/mm/iscandar/Mode.h b/mm/iscandar/Mode.h
new file mode 100644
index 000000000..ea2716897
--- /dev/null
+++ b/mm/iscandar/Mode.h
@@ -0,0 +1,65 @@
+/* Mode.h -- transcription target of Mode.py.
+ *
+ * A Mode is one named slice of the mode table, the
+ * half-open range of request sizes [lo, hi) it answers,
+ * together with the search C function that serves it.
+ * Mode.py dispatches every need of every mode through
+ * self.tuple(); in C the mode is a small struct: its
+ * range bounds and its search function pointer. The
+ * search signature is ModeSearchFn below, which is the
+ * shape the Modes table stores and the Engine invokes,
+ * exactly as the planes gear invokes its row handler.
+ */
+
+#ifndef ISCANDAR_MODE_H
+#define ISCANDAR_MODE_H
+
+#include <stdint.h>
+
+#include "Gears.h"
+
+/* The context a mode's search runs against: the cube's
+ * three counters the Python modes reach through self, plus
+ * the overall count CubeCheck's search reads. count_overall
+ * is -1 when the caller did not supply it (the Python's
+ * search(count_overall=None) case, where CubeCheck falls
+ * back to summing the plane counts). */
+typedef struct {
+    const uint32_t *count_planes; /* [32] */
+    const uint32_t *count_rows;   /* [1024] */
+    const uint32_t *words;        /* [1024] sector words */
+    int64_t         count_overall;
+} ModeCtx;
+
+/* A mode's search: the shape Mode.tuple() dispatches in
+ * the Python -- (count_planes, count_rows, words, request)
+ * in, (status, plane, row, sector) out, the counters and
+ * words carried on the ModeCtx. */
+typedef int32_t (*ModeSearchFn) (const ModeCtx *ctx,
+                                 uint32_t request,
+                                 uint32_t *plane_out,
+                                 uint32_t *row_out,
+                                 uint32_t *sector_out);
+
+typedef struct {
+    uint32_t     lo;     /* first size served */
+    uint32_t     hi;     /* one past the last size served */
+    ModeSearchFn search; /* this mode's search */
+} Mode;
+
+/* has_keying (Mode.has_keying): 1 when key lies in this
+ * mode's range, else 0. */
+int mode_has_keying(const Mode *mode, uint32_t key);
+
+/* The base search pattern (Mode.search in Mode.py): the
+ * planes gear over the cube, the rows row handler at each
+ * plane, the mode's bullet as the probe, the sectors words
+ * as the bullet's context -- Gears.scan in the Python. This
+ * is the search Nano and Tiny inherit unchanged. Returns
+ * the (status, plane, row, sector) tuple through the outs. */
+int32_t mode_base_search(const ModeCtx *ctx, uint32_t request,
+                         bullet_fn bullet,
+                         uint32_t *plane_out, uint32_t *row_out,
+                         uint32_t *sector_out);
+
+#endif /* ISCANDAR_MODE_H */
diff --git a/mm/iscandar/Modes.c b/mm/iscandar/Modes.c
new file mode 100644
index 000000000..8cfc7e981
--- /dev/null
+++ b/mm/iscandar/Modes.c
@@ -0,0 +1,192 @@
+/* Modes.c -- see Modes.h. Transcription of Modes.py (and
+ * the engine-reachable CubeCheck search from
+ * CubeCheck.py); the Python is the specification. */
+
+#include "Modes.h"
+
+#include "Cube.h"
+#include "Geometry.h"
+#include "Gears.h"
+#include "Huge.h"
+#include "Large.h"
+#include "Nano.h"
+#include "Nothing.h"
+#include "Plane.h"
+#include "Small.h"
+#include "Tiny.h"
+#include "status.h"
+
+/* --- searches -------------------------------------------------
+ * Each search below has the ModeSearchFn shape (Gears.h)
+ * and delegates to the transcribed class search of its
+ * mode, exactly as each Python class's search delegates;
+ * the CubeCheck search is the one exception, being short
+ * enough to stand here in full. Counters the Python
+ * reaches through self (count_planes, count_overall) are
+ * carried on the ModeCtx.
+ */
+
+/* Nothing.search returns None in the Python; here it is
+ * the identity sentinel: it serves nothing, and the
+ * Engine's comparison against modes_nothing() is what
+ * recognizes it. Its search is never invoked with effect;
+ * it returns GEAR_SUCCESS and zero coordinates, purely so
+ * the function pointer is valid. */
+static int32_t table_nothing_search(const ModeCtx *ctx,
+                              uint32_t request,
+                              uint32_t *plane_out,
+                              uint32_t *row_out,
+                              uint32_t *sector_out)
+{
+    (void)ctx;
+    (void)request;
+    *plane_out  = 0;
+    *row_out    = 0;
+    *sector_out = 0;
+    return GEAR_SUCCESS;
+}
+
+static int32_t table_nano_search(const ModeCtx *ctx, uint32_t request,
+                           uint32_t *plane_out, uint32_t *row_out,
+                           uint32_t *sector_out)
+{
+    /* Nano.search is the base Mode pattern with Nano's
+     * bullet (Mode.search, inherited unchanged). */
+    return mode_base_search(ctx, request, nano_bullet,
+                            plane_out, row_out, sector_out);
+}
+
+static int32_t table_tiny_search(const ModeCtx *ctx, uint32_t request,
+                           uint32_t *plane_out, uint32_t *row_out,
+                           uint32_t *sector_out)
+{
+    /* Tiny.search is likewise the base Mode pattern. */
+    return mode_base_search(ctx, request, tiny_bullet,
+                            plane_out, row_out, sector_out);
+}
+
+static int32_t table_small_search(const ModeCtx *ctx, uint32_t request,
+                            uint32_t *plane_out, uint32_t *row_out,
+                            uint32_t *sector_out)
+{
+    return small_search(request, ctx->count_planes,
+                        ctx->count_rows, ctx->words,
+                        plane_out, row_out, sector_out);
+}
+
+static int32_t table_large_search(const ModeCtx *ctx, uint32_t request,
+                            uint32_t *plane_out, uint32_t *row_out,
+                            uint32_t *sector_out)
+{
+    return large_search(request, ctx->count_planes,
+                        ctx->count_rows, ctx->words,
+                        plane_out, row_out, sector_out);
+}
+
+static int32_t table_huge_search(const ModeCtx *ctx,
+                                uint32_t request,
+                                uint32_t *plane_out,
+                                uint32_t *row_out,
+                                uint32_t *sector_out)
+{
+    return huge_search(request, ctx->count_planes,
+                       ctx->count_rows, ctx->words,
+                       plane_out, row_out, sector_out);
+}
+
+/* CubeCheck.search: the cube answers a whole-cube request
+ * only when every sector is free. count_overall falls
+ * back to the sum of the plane counts when the caller did
+ * not pass it, as the Python does (in the Engine it is
+ * always passed). */
+static int32_t table_cubecheck_search(const ModeCtx *ctx,
+                                uint32_t request,
+                                uint32_t *plane_out,
+                                uint32_t *row_out,
+                                uint32_t *sector_out)
+{
+    uint32_t overall;
+    uint32_t i;
+
+    *plane_out  = 0;
+    *row_out    = 0;
+    *sector_out = 0;
+    if (request != CUBE_SECTORS_PER_CUBE) {
+        return GEAR_EXHAUST;
+    }
+    if (ctx->count_overall >= 0) {
+        overall = (uint32_t)ctx->count_overall;
+    } else {
+        overall = 0;
+        for (i = 0; i < CUBE_PLANES_PER_CUBE; i++) {
+            overall += ctx->count_planes[i];
+        }
+    }
+    if (overall != 0) {
+        return GEAR_EXHAUST;
+    }
+    return GEAR_SUCCESS;
+}
+
+/* --- the modes ------------------------------------------------
+ * Ranges half-open, built from the class bounds
+ * (Modes.tuple in the Python), in the Python's
+ * construction order: Nothing, Nano, Tiny, Small, Large,
+ * Huge, CubeCheck.
+ */
+
+/* Half-open bounds, from each class's range() in the
+ * Python (inclusive bounds there, +1 here): Nothing {0},
+ * Nano 1..8, Tiny 9..32, Small 33..64, Large 65..1024,
+ * Huge 1025..32767, CubeCheck {32768}. */
+static const Mode nothing_mode = { 0, 1, table_nothing_search };
+static const Mode nano_mode = { 1, 9, table_nano_search };
+static const Mode tiny_mode = { 9, 33, table_tiny_search };
+static const Mode small_mode = { 33, 65, table_small_search };
+static const Mode large_mode = { 65, 1025, table_large_search };
+static const Mode huge_mode = { 1025, 32768, table_huge_search };
+static const Mode cubecheck_mode = {
+    CUBE_SECTORS_PER_CUBE, CUBE_SECTORS_PER_CUBE + 1,
+    table_cubecheck_search
+};
+
+uint32_t modes_count(void)
+{
+    return CUBE_SECTORS_PER_CUBE + 1;
+}
+
+int modes_has_key(uint32_t key)
+{
+    return key <= CUBE_SECTORS_PER_CUBE;
+}
+
+const Mode *modes_get(uint32_t key)
+{
+    if (key == 0) {
+        return &nothing_mode;
+    }
+    if (key < nano_mode.hi && key >= nano_mode.lo) {
+        return &nano_mode;
+    }
+    if (key < tiny_mode.hi && key >= tiny_mode.lo) {
+        return &tiny_mode;
+    }
+    if (key < small_mode.hi && key >= small_mode.lo) {
+        return &small_mode;
+    }
+    if (key < large_mode.hi && key >= large_mode.lo) {
+        return &large_mode;
+    }
+    if (key < huge_mode.hi && key >= huge_mode.lo) {
+        return &huge_mode;
+    }
+    if (key == CUBE_SECTORS_PER_CUBE) {
+        return &cubecheck_mode;
+    }
+    return &nothing_mode;
+}
+
+const Mode *modes_nothing(void)
+{
+    return &nothing_mode;
+}
diff --git a/mm/iscandar/Modes.h b/mm/iscandar/Modes.h
new file mode 100644
index 000000000..fb38a2fe9
--- /dev/null
+++ b/mm/iscandar/Modes.h
@@ -0,0 +1,51 @@
+/* Modes.h -- transcription target of Modes.py.
+ *
+ * Modes builds the dispatch table: every request size in
+ * the cube's range maps to the mode that answers it. The
+ * Python's dict is built by successive merges in a fixed
+ * order -- Error's full range first, then Message
+ * (Nothing), then the request modes, then CubeCheck last,
+ * each later merge overriding the earlier entries for its
+ * keys -- so the final table is: key 0 -> Nothing, keys
+ * 1..32767 -> the request mode of their class, key 32768
+ * -> CubeCheck. That is the whole content of the merge
+ * order once it has run, and it is what modes_get
+ * reproduces: the fallback (Nothing, for a key outside
+ * every range) matches the Engine's .get(request, nothing)
+ * fallback in the Python.
+ *
+ * CubeCheck is engine-reachable through this table at
+ * request 32768, so its search is transcribed here as a
+ * mode; CubeCheck.py itself is check instrumentation and
+ * is not transcribed.
+ */
+
+#ifndef ISCANDAR_MODES_H
+#define ISCANDAR_MODES_H
+
+#include <stdint.h>
+
+#include "Mode.h"
+
+/* modes_count: the size of the Python's merged table,
+ * 32769 entries, keys 0..32768 -- the same figure
+ * test_table_size_and_keys pins. */
+uint32_t modes_count(void);
+
+/* modes_has_key: 1 when key is in the table's key range
+ * 0..32768, else 0. */
+int modes_has_key(uint32_t key);
+
+/* modes_get: the mode serving key; falls back to the
+ * Nothing mode for any key outside the table, exactly as
+ * the Python Engine's modes.get(request, nothing) does.
+ * The returned pointer is to static storage owned by
+ * this module. */
+const Mode *modes_get(uint32_t key);
+
+/* modes_nothing: the table's Nothing mode (the fallback),
+ * so the Engine can compare a served mode against it the
+ * way the Python compares against its Nothing instance. */
+const Mode *modes_nothing(void);
+
+#endif /* ISCANDAR_MODES_H */
diff --git a/mm/iscandar/Nano.c b/mm/iscandar/Nano.c
new file mode 100644
index 000000000..c3c659fb0
--- /dev/null
+++ b/mm/iscandar/Nano.c
@@ -0,0 +1,50 @@
+/* Nano.c -- see Nano.h. Transcription of Nano.py; the
+ * Python is the specification. */
+
+#include "Nano.h"
+
+#include "Geometry.h"
+#include "status.h"
+
+void nano_range(uint32_t *lo_out, uint32_t *hi_out)
+{
+    *lo_out = 1;
+    *hi_out = GEOMETRY_SECTORS_PER_BYTE;
+}
+
+int32_t nano_bullet(uint32_t plane, uint32_t row,
+                    uint32_t request, void *ctx,
+                    uint32_t *sector_out)
+{
+    const uint32_t *words = (const uint32_t *)ctx;
+    uint32_t global_row;
+    uint32_t s;
+    uint32_t pos;
+
+    /* Boundary check, as in Listing 17: GlobalRow past
+     * 1023 fails. Out-of-domain length fails the same way. */
+    global_row = plane * GEOMETRY_ARITY + row;
+    if (global_row > 1023) {
+        return NANO_FAIL;
+    }
+    if (request < 1 || request > GEOMETRY_SECTORS_PER_BYTE) {
+        return NANO_FAIL;
+    }
+
+    s = words[global_row];
+
+    /* Center function, position order (MSB first): the
+     * smallest pos whose mask of L clear bits finds nothing
+     * set. The mask formula is the paper's:
+     * ((1 << L) - 1) << (32 - L - pos). */
+    for (pos = 0; pos + request <= 32; pos++) {
+        uint32_t mask = ((1u << request) - 1u)
+                        << (32 - request - pos);
+        if ((s & mask) == 0) {
+            *sector_out = 31 - pos - request + 1;
+            return GEAR_SUCCESS;
+        }
+    }
+
+    return NANO_FAIL;
+}
