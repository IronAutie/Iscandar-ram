From 844cbbcf885f8c8e05eefe555bb8882f80ac5c3d Mon Sep 17 00:00:00 2001
From: Iscandar build <iscandar@local>
Date: Fri, 20 Nov 2026 19:25:20 -0800
Subject: [PATCH] iscandar: vmalloc backing at 2.3, free doors at 2.4, in
 kernel form

---
 mm/vmalloc.c | 33 +++++++++++++++++++++++++++++++++
 1 file changed, 33 insertions(+)

diff --git a/mm/vmalloc.c b/mm/vmalloc.c
index b11552177..bdc06d3e9 100644
--- a/mm/vmalloc.c
+++ b/mm/vmalloc.c
@@ -43,6 +43,7 @@
 #include <asm/tlbflush.h>
 #include <asm/shmparam.h>
 #include <linux/page_owner.h>
+#include <linux/iscandar.h>
 
 #define CREATE_TRACE_POINTS
 #include <trace/events/vmalloc.h>
@@ -3375,6 +3376,16 @@ void vfree_atomic(const void *addr)
 	struct vfree_deferred *p = raw_cpu_ptr(&vfree_deferred);
 
 	BUG_ON(in_nmi());
+
+	/* The same door as vfree, taken in this build: the
+	 * core's free path does not sleep, so the atomic
+	 * caller's contract is met by the same range
+	 * decision and the same call, not by deferral. */
+	if (iscandar_ptr_in_arena(addr)) {
+		iscandar_free(addr, 0);
+		return;
+	}
+
 	kmemleak_free(addr);
 
 	/*
@@ -3409,6 +3420,11 @@ void vfree(const void *addr)
 	struct vm_struct *vm;
 	int i;
 
+	if (iscandar_ptr_in_arena(addr)) {
+		iscandar_free(addr, 0);
+		return;
+	}
+
 	if (unlikely(in_interrupt())) {
 		vfree_atomic(addr);
 		return;
@@ -3594,6 +3610,23 @@ static inline unsigned int
 vm_area_alloc_pages(gfp_t gfp, int nid,
 		unsigned int order, unsigned int nr_pages, struct page **pages)
 {
+	if (iscandar_active()) {
+		void *run;
+		unsigned int i;
+
+		run = iscandar_alloc((u64)nr_pages << PAGE_SHIFT,
+				     PAGE_SIZE, 0);
+		if (!run)
+			return 0;
+		for (i = 0; i < nr_pages; i++)
+			pages[i] = iscandar_offset_to_page(
+				iscandar_ptr_to_offset(run)
+				+ ((u64)i << PAGE_SHIFT));
+		return nr_pages;
+	}
+	iscandar_prefix_note(ISCANDAR_CENTER_VMALLOC_BACKING,
+			     (size_t)nr_pages << PAGE_SHIFT);
+
 	unsigned int nr_allocated = 0;
 	struct page *page;
 	int i;
-- 
2.43.0

