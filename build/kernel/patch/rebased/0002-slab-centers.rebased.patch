From 7b4db960a0ffc803bf4aaaa4cffe4421ce5c686d Mon Sep 17 00:00:00 2001
From: Iscandar build <iscandar@local>
Date: Fri, 20 Nov 2026 19:25:07 -0800
Subject: [PATCH] iscandar: the slab centers in kernel form (1.1, 1.3, 1.4)

---
 mm/slub.c | 66 +++++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 66 insertions(+)

diff --git a/mm/slub.c b/mm/slub.c
index aeb9fdd76..981140f75 100644
--- a/mm/slub.c
+++ b/mm/slub.c
@@ -44,6 +44,7 @@
 #include <linux/sort.h>
 
 #include <linux/debugfs.h>
+#include <linux/iscandar.h>
 #include <trace/events/kmem.h>
 
 #include "internal.h"
@@ -2474,6 +2475,12 @@ static inline struct slab *alloc_slab_page(gfp_t flags, int node,
 	struct slab *slab;
 	unsigned int order = oo_order(oo);
 
+	/* Watch point, instrumented only. Under the bypass
+	 * ruling this counter must not move for a redirected
+	 * cache after the early-boot prefix; the evidence run
+	 * reads it from /proc/iscandar. */
+	atomic64_inc(&iscandar_slab_page_calls);
+
 	if (node == NUMA_NO_NODE)
 		folio = (struct folio *)alloc_pages(flags, order);
 	else
@@ -4208,6 +4215,26 @@ static __fastpath_inline void *slab_alloc_node(struct kmem_cache *s, struct list
 	void *object;
 	bool init = false;
 
+	if (iscandar_active()) {
+		u32 cache_id = iscandar_cache_lookup(s);
+
+		if (cache_id == 0)
+			/* A cache with no registry entry after
+			 * ready: a finding, not a fallback. */
+			return NULL;
+		object = iscandar_alloc(s->object_size, s->align,
+					cache_id);
+		if (!object)
+			return NULL;
+		if (s->ctor)
+			s->ctor(object);
+		if (unlikely(gfpflags & __GFP_ZERO))
+			memset(object, 0, s->object_size);
+		return object;
+	}
+	iscandar_prefix_note(ISCANDAR_CENTER_SLAB_ALLOC,
+			     s->object_size);
+
 	s = slab_pre_alloc_hook(s, gfpflags);
 	if (unlikely(!s))
 		return NULL;
@@ -4325,6 +4352,17 @@ static void *___kmalloc_large_node(size_t size, gfp_t flags, int node)
 
 void *__kmalloc_large_noprof(size_t size, gfp_t flags)
 {
+	if (iscandar_active()) {
+		void *object = iscandar_alloc(size, 0, 0);
+
+		if (!object)
+			return NULL;
+		if (unlikely(flags & __GFP_ZERO))
+			memset(object, 0, size);
+		return object;
+	}
+	iscandar_prefix_note(ISCANDAR_CENTER_KMALLOC_LARGE, size);
+
 	void *ret = ___kmalloc_large_node(size, flags, NUMA_NO_NODE);
 
 	trace_kmalloc(_RET_IP_, ret, size, PAGE_SIZE << get_order(size),
@@ -4784,6 +4822,10 @@ static inline struct kmem_cache *cache_from_obj(struct kmem_cache *s, void *x)
  */
 void kmem_cache_free(struct kmem_cache *s, void *x)
 {
+	if (iscandar_ptr_in_arena(x)) {
+		iscandar_free(x, iscandar_cache_lookup(s));
+		return;
+	}
 	s = cache_from_obj(s, x);
 	if (!s)
 		return;
@@ -4816,6 +4858,10 @@ static void free_large_kmalloc(struct folio *folio, void *object)
  */
 void kfree(const void *object)
 {
+	if (iscandar_ptr_in_arena(object)) {
+		iscandar_free(object, 0);
+		return;
+	}
 	struct folio *folio;
 	struct slab *slab;
 	struct kmem_cache *s;
@@ -4947,6 +4993,26 @@ void kmem_cache_free_bulk(struct kmem_cache *s, size_t size, void **p)
 	if (!size)
 		return;
 
+	/* Each pointer decides by its own range: arena-born
+	 * pointers go home one by one; the rest are compacted
+	 * to the tail and freed by the stock body below. */
+	{
+		size_t i, stock = size;
+		u32 cache_id = iscandar_cache_lookup(s);
+
+		for (i = 0; i < size; i++) {
+			if (iscandar_ptr_in_arena(p[i])) {
+				iscandar_free(p[i], cache_id);
+				p[i] = p[--stock];
+				p[stock] = NULL;
+				i--;
+			}
+		}
+		size = stock;
+		if (size == 0)
+			return;
+	}
+
 	do {
 		struct detached_freelist df;
 
-- 
2.43.0

