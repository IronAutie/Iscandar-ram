@@ -0,0 +1,521 @@
+// SPDX-License-Identifier: GPL-2.0
+/* iscandar core -- the in-kernel Iscandar, kernel round.
+ * The engine is seated over the marked mass by cast; the
+ * mass is the state, in the form the engine reads
+ * (build/kernel/MASS-LAYOUT.md). Scaffolding at the
+ * author's direction; the allocator is the engine in the
+ * same directory, the admitted C text, unmodified (R9).
+ * See build/kernel/patch/README.md in the Iscandar-ram
+ * repository for the staging terms. */
+
+#include <linux/atomic.h>
+#include <linux/genalloc.h>
+#include <linux/init.h>
+#include <linux/iscandar.h>
+#include <linux/kernel.h>
+#include <linux/mm.h>
+#include <linux/mutex.h>
+#include <linux/proc_fs.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <linux/string.h>
+#include <linux/timex.h>
+
+#include "Beam.h"
+#include "BeamCoordinate.h"
+#include "CPUPointer.h"
+
+/* The mass and the arena, emitted by gen_mass.py and
+ * placed by the linker script (the placement hunk in
+ * this patch). The layout mirrors the admitted structs
+ * byte for byte, so the seats below are casts, with no
+ * translation and no seating code. */
+extern Beam iscandar_beam;
+extern u16 iscandar_ledger[];
+extern char iscandar_registry[];
+extern char iscandar_mass_start[];
+extern char iscandar_arena_start[];
+extern char iscandar_arena_end[];
+
+static Beam *const beam = &iscandar_beam;
+static u16 *const ledger = iscandar_ledger;
+static void *const arena = iscandar_arena_start;
+
+/* Region offsets in the mass, from MASS-LAYOUT.md:
+ * Beam state 266,512 B, extent ledger 262,144 B, cache
+ * registry 32,768 B, in that order. */
+#define ISCANDAR_LEDGER_PAGES	ISCANDAR_ARENA_PAGES
+
+/* The registry entry, at the mass's fixed 64-byte
+ * stride. The cache pointer is written last at
+ * publication and cleared first at removal; a zero
+ * pointer is a free entry. */
+struct iscandar_registry_entry {
+	struct kmem_cache *s;
+	u64 live;
+	u32 id;
+	u32 size;
+	u32 align;
+	u32 flags;
+	u32 reserved[8];
+};
+
+static struct iscandar_registry_entry *const registry =
+	(struct iscandar_registry_entry *)iscandar_registry;
+
+static void iscandar_registry_stride_check(void)
+{
+	BUILD_BUG_ON(sizeof(struct iscandar_registry_entry) != 64);
+}
+
+/* State: prefix until the canary opens ready; closed
+ * for the boot on a canary refusal or iscandar_hold. */
+enum iscandar_state {
+	ISCANDAR_ST_PREFIX,
+	ISCANDAR_ST_READY,
+	ISCANDAR_ST_CLOSED,
+};
+static enum iscandar_state iscandar_state = ISCANDAR_ST_PREFIX;
+static bool iscandar_hold;
+
+static DEFINE_SPINLOCK(iscandar_engine_lock);
+static DEFINE_MUTEX(iscandar_control_lock);
+
+static u64 iscandar_live_pages;
+static u64 iscandar_refusals;
+static u64 iscandar_violations;
+
+atomic64_t iscandar_slab_page_calls = ATOMIC64_INIT(0);
+
+bool iscandar_active(void)
+{
+	return READ_ONCE(iscandar_state) == ISCANDAR_ST_READY;
+}
+
+void *iscandar_offset_to_ptr(u64 offset)
+{
+	return (void *)((char *)arena + offset);
+}
+
+struct page *iscandar_offset_to_page(u64 offset)
+{
+	return virt_to_page((char *)arena + offset);
+}
+
+bool iscandar_ptr_in_arena(const void *p)
+{
+	return p >= arena && p < (void *)iscandar_arena_end;
+}
+
+u64 iscandar_ptr_to_offset(const void *p)
+{
+	return (u64)((const char *)p - (const char *)arena);
+}
+
+/* The prefix machinery: counters per center and a ring
+ * of the calls stock served, in the bridge core's
+ * shape, now read by this file's own state read. */
+static u32 iscandar_prefix_calls[ISCANDAR_CENTER_COUNT];
+static struct {
+	u32 center;
+	u32 size;
+} iscandar_prefix_log[ISCANDAR_PREFIX_ENTRIES];
+static u32 iscandar_prefix_logged;
+static bool iscandar_prefix_overflow;
+
+void iscandar_prefix_note(unsigned int center, size_t size)
+{
+	if (iscandar_state != ISCANDAR_ST_PREFIX)
+		return;	/* the note is for the prefix only; call
+			 * sites may reach it in any state */
+	if (center >= ISCANDAR_CENTER_COUNT)
+		return;
+	iscandar_prefix_calls[center]++;
+	if (iscandar_prefix_logged < ISCANDAR_PREFIX_ENTRIES) {
+		u32 slot = iscandar_prefix_logged++;
+
+		iscandar_prefix_log[slot].center = center;
+		iscandar_prefix_log[slot].size = (u32)size;
+	} else {
+		iscandar_prefix_overflow = true;
+	}
+}
+
+/* The latency ledger: worst cycles and counts per
+ * class, classes at the engine's gear boundaries in
+ * the request unit (pages, at this build's
+ * calibration). Sampled at the doors, inside the
+ * section; the walk is untouched. */
+enum iscandar_class {
+	ISCANDAR_CL_NANO,	/* 1 to 8 */
+	ISCANDAR_CL_TINY,	/* 9 to 32 */
+	ISCANDAR_CL_SMALL,	/* 33 to 64 */
+	ISCANDAR_CL_LARGE,	/* 65 to 1024 */
+	ISCANDAR_CL_HUGE,	/* 1025 to 32767 */
+	ISCANDAR_CL_CUBECHECK,	/* exactly 32768 */
+	ISCANDAR_CL_COUNT,
+};
+static u64 iscandar_worst_cycles[ISCANDAR_CL_COUNT];
+static u64 iscandar_class_calls[ISCANDAR_CL_COUNT];
+
+static enum iscandar_class iscandar_class_of(u32 pages)
+{
+	if (pages <= 8)
+		return ISCANDAR_CL_NANO;
+	if (pages <= 32)
+		return ISCANDAR_CL_TINY;
+	if (pages <= 64)
+		return ISCANDAR_CL_SMALL;
+	if (pages <= 1024)
+		return ISCANDAR_CL_LARGE;
+	if (pages < ISCANDAR_CUBE_PAGES)
+		return ISCANDAR_CL_HUGE;
+	return ISCANDAR_CL_CUBECHECK;
+}
+
+static void iscandar_latency_note(enum iscandar_class cl,
+				  cycles_t start)
+{
+	cycles_t dt = get_cycles() - start;
+
+	iscandar_class_calls[cl]++;
+	if (dt > iscandar_worst_cycles[cl])
+		iscandar_worst_cycles[cl] = dt;
+}
+
+/* CPUPointer to global page, and back: the bijection
+ * of record, start = cube * 32768 + local (CPUPointer.h).
+ * The coordinate calls are the BeamCoordinate header's
+ * own; the re-base binds these two helpers to them. */
+static u32 iscandar_cptr_to_page(const CPUPointer *ptr)
+{
+	BeamCoordinate bc;
+
+	beam_coordinate_from_pointer(&bc, ptr);
+	return (u32)bc.cube * ISCANDAR_CUBE_PAGES + (u32)bc.local;
+}
+
+static void iscandar_page_to_cptr(u32 page, CPUPointer *out)
+{
+	BeamCoordinate bc;
+
+	beam_coordinate_init(&bc, (int32_t)(page / ISCANDAR_CUBE_PAGES),
+			     (int32_t)(page % ISCANDAR_CUBE_PAGES), 1);
+	beam_coordinate_to_pointer(&bc, out);
+}
+
+static void iscandar_registry_live(u32 cache_id, int delta)
+{
+	struct iscandar_registry_entry *e;
+
+	if (!cache_id || cache_id > ISCANDAR_REGISTRY_CAP)
+		return;
+	e = &registry[cache_id - 1];
+	if (e->id == cache_id && e->s)
+		e->live += delta;
+}
+
+void *iscandar_alloc(size_t size, unsigned int align, u32 cache_id)
+{
+	u32 pages, page;
+	CPUPointer ptr;
+	unsigned long flags;
+	cycles_t t0;
+	int32_t st;
+
+	if (unlikely(size == 0))
+		return ZERO_SIZE_PTR;
+	/* Grants are page-aligned by construction; a larger
+	 * alignment is refused here and in the doors' own
+	 * rejection sets, never silently rounded. */
+	if (unlikely(align > PAGE_SIZE))
+		return NULL;
+	pages = DIV_ROUND_UP(size, PAGE_SIZE);
+	if (unlikely(pages > ISCANDAR_CUBE_PAGES)) {
+		iscandar_refusals++;
+		return NULL;
+	}
+	spin_lock_irqsave(&iscandar_engine_lock, flags);
+	t0 = get_cycles();
+	st = beam_allocate(beam, (int32_t)pages, &ptr);
+	iscandar_latency_note(iscandar_class_of(pages), t0);
+	if (st != K4_SUCCESS) {
+		iscandar_refusals++;
+		spin_unlock_irqrestore(&iscandar_engine_lock, flags);
+		return NULL;
+	}
+	page = iscandar_cptr_to_page(&ptr);
+	if (unlikely(ledger[page] != 0)) {
+		/* The store granted what the ledger says is
+		 * live: the books disagree. Return the grant,
+		 * count it, and refuse. Debugger time (R12). */
+		(void)beam_free(beam, &ptr);
+		iscandar_violations++;
+		spin_unlock_irqrestore(&iscandar_engine_lock, flags);
+		pr_err("iscandar: ledger bin %u nonzero (%u) under a fresh grant\n",
+		       page, ledger[page]);
+		return NULL;
+	}
+	ledger[page] = (u16)pages;
+	iscandar_live_pages += pages;
+	iscandar_registry_live(cache_id, 1);
+	spin_unlock_irqrestore(&iscandar_engine_lock, flags);
+	return (void *)((char *)arena + ((u64)page << PAGE_SHIFT));
+}
+
+void iscandar_free(const void *p, u32 cache_id)
+{
+	u32 page, count;
+	CPUPointer ptr;
+	unsigned long flags;
+	cycles_t t0;
+	int32_t st;
+
+	if (unlikely(!iscandar_ptr_in_arena(p))) {
+		/* The doors range-test first; a call here with
+		 * an out-of-arena pointer is a door bug, on the
+		 * record as a violation, never served. */
+		iscandar_violations++;
+		pr_err("iscandar: free called out of arena (%p)\n", p);
+		return;
+	}
+	page = (u32)(iscandar_ptr_to_offset(p) >> PAGE_SHIFT);
+	spin_lock_irqsave(&iscandar_engine_lock, flags);
+	count = ledger[page];
+	if (unlikely(count == 0)) {
+		iscandar_violations++;
+		spin_unlock_irqrestore(&iscandar_engine_lock, flags);
+		pr_err("iscandar: free of ungranted arena page %u\n", page);
+		return;
+	}
+	iscandar_page_to_cptr(page, &ptr);
+	t0 = get_cycles();
+	st = beam_free(beam, &ptr);
+	iscandar_latency_note(iscandar_class_of(count), t0);
+	if (unlikely(st != K4_SUCCESS)) {
+		/* The store refused what the ledger granted:
+		 * an overlay or double-free class event. The
+		 * books stay exactly as they are; the finding
+		 * is the record (R12). */
+		iscandar_violations++;
+		spin_unlock_irqrestore(&iscandar_engine_lock, flags);
+		pr_err("iscandar: engine free status %d at page %u\n",
+		       st, page);
+		return;
+	}
+	ledger[page] = 0;
+	iscandar_live_pages -= count;
+	iscandar_registry_live(cache_id, -1);
+	spin_unlock_irqrestore(&iscandar_engine_lock, flags);
+}
+
+/* The registry: control path, mutex, confirm-then-commit. */
+u32 iscandar_cache_lookup(struct kmem_cache *s)
+{
+	int i;
+
+	for (i = 0; i < ISCANDAR_REGISTRY_CAP; i++)
+		if (registry[i].s == s)
+			return registry[i].id;
+	return 0;
+}
+
+int iscandar_cache_register(struct kmem_cache *s, size_t size,
+			    unsigned int align, unsigned long flags)
+{
+	struct iscandar_registry_entry stage = { };
+	int i, slot = -1;
+
+	stage.size = (u32)size;
+	stage.align = align;
+	stage.flags = (u32)flags;
+	mutex_lock(&iscandar_control_lock);
+	if (iscandar_cache_lookup(s)) {
+		mutex_unlock(&iscandar_control_lock);
+		return 0;	/* already registered */
+	}
+	for (i = 0; i < ISCANDAR_REGISTRY_CAP; i++)
+		if (!registry[i].s) {
+			slot = i;
+			break;
+		}
+	if (slot < 0) {
+		mutex_unlock(&iscandar_control_lock);
+		pr_err("iscandar: registry full at cap %u, cache %p refused\n",
+		       ISCANDAR_REGISTRY_CAP, s);
+		return -ENOSPC;	/* the cap is the verdict */
+	}
+	stage.id = (u32)slot + 1;
+	registry[slot] = stage;
+	smp_wmb();	/* the entry stands before its name does */
+	registry[slot].s = s;
+	mutex_unlock(&iscandar_control_lock);
+	return 0;
+}
+
+void iscandar_cache_unregister(struct kmem_cache *s)
+{
+	int i;
+
+	mutex_lock(&iscandar_control_lock);
+	for (i = 0; i < ISCANDAR_REGISTRY_CAP; i++) {
+		if (registry[i].s == s) {
+			if (registry[i].live)
+				/* The disagreement is on the record,
+				 * not papered over: the teardown
+				 * proceeds, as the bridge staging
+				 * ruled for this case. */
+				pr_err("iscandar: cache %p destroyed with %llu grants live\n",
+				       s, registry[i].live);
+			registry[i].s = NULL;
+			smp_wmb();
+			memset(&registry[i], 0, sizeof(registry[i]));
+			break;
+		}
+	}
+	mutex_unlock(&iscandar_control_lock);
+}
+
+/* The gen_pool gate, under the backing rule: a pool is
+ * served while every chunk added so far is wholly
+ * ordinary system RAM; a failing chunk marks it stock
+ * permanently. The RAM test is the tree's own, applied
+ * page by page at chunk-add (control path); its binding
+ * to the tree's System RAM walk is the re-base's. */
+static bool iscandar_range_is_ram(phys_addr_t phys, size_t size);
+
+static struct {
+	struct gen_pool *pool;
+	bool decided_stock;
+	bool has_chunk;
+} iscandar_pool_decisions[16];
+
+void iscandar_gen_pool_note_chunk(struct gen_pool *pool,
+				  phys_addr_t phys, size_t size)
+{
+	int i, slot = -1;
+
+	mutex_lock(&iscandar_control_lock);
+	for (i = 0; i < 16; i++) {
+		if (iscandar_pool_decisions[i].pool == pool) {
+			slot = i;
+			break;
+		}
+		if (!iscandar_pool_decisions[i].pool && slot < 0)
+			slot = i;
+	}
+	if (slot < 0) {
+		mutex_unlock(&iscandar_control_lock);
+		pr_err("iscandar: gen_pool decision table full, pool %p stock\n",
+		       pool);
+		return;
+	}
+	iscandar_pool_decisions[slot].pool = pool;
+	if (!iscandar_pool_decisions[slot].decided_stock) {
+		if (iscandar_range_is_ram(phys, size)) {
+			iscandar_pool_decisions[slot].has_chunk = true;
+		} else {
+			iscandar_pool_decisions[slot].decided_stock = true;
+			if (iscandar_pool_decisions[slot].has_chunk)
+				pr_err("iscandar: pool %p gains a non-RAM chunk after RAM chunks; stock from here, live grants are a finding\n",
+				       pool);
+		}
+	}
+	mutex_unlock(&iscandar_control_lock);
+}
+
+bool iscandar_gen_pool_served(struct gen_pool *pool)
+{
+	int i;
+
+	for (i = 0; i < 16; i++)
+		if (iscandar_pool_decisions[i].pool == pool)
+			return iscandar_pool_decisions[i].has_chunk
+			    && !iscandar_pool_decisions[i].decided_stock;
+	return false;
+}
+
+/* The state read: a window, not a source. Its first
+ * line is the state line, in the three-way form. */
+static const char *const iscandar_class_names[ISCANDAR_CL_COUNT] = {
+	"nano", "tiny", "small", "large", "huge", "cubecheck",
+};
+
+static int iscandar_proc_show(struct seq_file *m, void *v)
+{
+	static const char *const state_names[] = {
+		"prefix", "ready", "closed",
+	};
+	int i, registered = 0;
+	u64 live_grants = 0;
+
+	seq_printf(m, "state %s\n", state_names[iscandar_state]);
+	seq_printf(m, "beam cardinality %d count_overall %d sectors_supported %d lead %d\n",
+		   beam->cardinality, beam->count_overall,
+		   beam->sectors_supported, beam->lead);
+	seq_printf(m, "live_pages %llu refusals %llu violations %llu slab_page_calls %lld\n",
+		   iscandar_live_pages, iscandar_refusals,
+		   iscandar_violations,
+		   (long long)atomic64_read(&iscandar_slab_page_calls));
+	for (i = 0; i < ISCANDAR_CL_COUNT; i++)
+		seq_printf(m, "class %s calls %llu worst_cycles %llu\n",
+			   iscandar_class_names[i],
+			   iscandar_class_calls[i],
+			   iscandar_worst_cycles[i]);
+	for (i = 0; i < ISCANDAR_CENTER_COUNT; i++)
+		if (iscandar_prefix_calls[i])
+			seq_printf(m, "prefix center %d calls %u\n",
+				   i, iscandar_prefix_calls[i]);
+	if (iscandar_prefix_overflow)
+		seq_puts(m, "prefix log overflow\n");
+	for (i = 0; i < ISCANDAR_REGISTRY_CAP; i++)
+		if (registry[i].s) {
+			registered++;
+			live_grants += registry[i].live;
+		}
+	seq_printf(m, "registry registered %d live_grants %llu\n",
+		   registered, live_grants);
+	for (i = 0; i < 16; i++)
+		if (iscandar_pool_decisions[i].pool)
+			seq_printf(m, "gen_pool %p %s\n",
+				   iscandar_pool_decisions[i].pool,
+				   iscandar_gen_pool_served(
+					iscandar_pool_decisions[i].pool)
+				   ? "served" : "stock");
+	return 0;
+}
+
+static int iscandar_proc_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, iscandar_proc_show, NULL);
+}
+
+static const struct proc_ops iscandar_proc_ops = {
+	.proc_open	= iscandar_proc_open,
+	.proc_read	= seq_read,
+	.proc_lseek	= seq_lseek,
+	.proc_release	= single_release,
+};
+
+static int __init iscandar_hold_setup(char *str)
+{
+	iscandar_hold = true;
+	return 1;
+}
+__setup("iscandar_hold", iscandar_hold_setup);
+
+/* The canary, in the design's section 5 form: verify the
+ * born mass from its own bytes, then read the witness
+ * word by independent paths. Init verifies; it does not
+ * fill (R8). Any failure leaves the engine shut for the
+ * boot, state closed, with the figures printed. */
+static int __init iscandar_init(void)
+{
+	u32 a, b, c;
+	int cube, i;
+
+	proc_create("iscandar", 0444, NULL, &iscandar_proc_ops);
+
+	if (iscandar_hold) {
+		iscandar_state = ISCANDAR_ST_CLOSED;
+		pr_info("iscandar: held shut by iscandar_hold; stock serves\n");
+		return 0;
+	}
+	for (cube = 0; cube < beam->cardinality; cube++) {
+		Engine *e = &beam->engines[cube].engine;
+		u32 pop = 0, rows = 0, planes = 0;
+
+		for (i = 0; i < 1024; i++) {
+			pop += hweight32(e->cube.words[i]);
+			rows += e->count_rows[i];
+		}
+		for (i = 0; i < 32; i++)
+			planes += e->count_planes[i];
+		if (pop != e->count_overall || rows != e->count_overall
+		    || planes != e->count_overall
+		    || beam->engines[cube].count_overall != e->count_overall) {
+			pr_err("iscandar: mass inconsistent in cube %d: popcount %u rows %u planes %u count %u mirror %u; engine shut\n",
+			       cube, pop, rows, planes, e->count_overall,
+			       beam->engines[cube].count_overall);
+			iscandar_state = ISCANDAR_ST_CLOSED;
+			return 0;
+		}
+	}
+	for (i = 0; i < ISCANDAR_LEDGER_PAGES; i++) {
+		if (ledger[i] != 0) {
+			pr_err("iscandar: ledger born nonzero at bin %d (%u); engine shut\n",
+			       i, ledger[i]);
+			iscandar_state = ISCANDAR_ST_CLOSED;
+			return 0;
+		}
+	}
+	for (i = 0; i < ISCANDAR_REGISTRY_CAP; i++) {
+		if (registry[i].s) {
+			pr_err("iscandar: registry born occupied at %d; engine shut\n",
+			       i);
+			iscandar_state = ISCANDAR_ST_CLOSED;
+			return 0;
+		}
+	}
+	/* The witness word: cube 0, store word 0, the fixture
+	 * word of MASS-LAYOUT.md. Path one, by byte offset
+	 * from the mass base (the Beam header is 16 bytes;
+	 * cube 0's store is the slot's first field). Path
+	 * two, through the struct. Path three, through the
+	 * page path. */
+	a = *(u32 *)(iscandar_mass_start + 16);
+	b = beam->engines[0].engine.cube.words[0];
+	c = *(u32 *)((char *)page_address(
+		virt_to_page(iscandar_mass_start + 16)) + 16);
+	if (a != b || a != c || a != 0x07FFFFFF) {
+		pr_err("iscandar: canary disagreement: offset path %08x at %p, struct path %08x at %p, page path %08x; engine shut\n",
+		       a, iscandar_mass_start + 16, b,
+		       &beam->engines[0].engine.cube.words[0], c);
+		iscandar_state = ISCANDAR_ST_CLOSED;
+		return 0;
+	}
+	smp_wmb();
+	WRITE_ONCE(iscandar_state, ISCANDAR_ST_READY);
+	pr_info("iscandar: ready; count_overall %d, net served %d pages\n",
+		beam->count_overall,
+		beam->sectors_supported - beam->count_overall);
+	return 0;
+}
+postcore_initcall(iscandar_init);
--- a/mm/Makefile
+++ b/mm/Makefile
@@ -1,4 +1,5 @@
 # SPDX-License-Identifier: GPL-2.0
