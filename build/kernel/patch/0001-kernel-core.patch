+/* SPDX-License-Identifier: GPL-2.0 */
+/* iscandar.h -- the kernel-internal Iscandar API, kernel
+ * round. The build constants and center numbers live in
+ * <iscandar_bridge.h>, copied verbatim from the build's
+ * one shared header at patch application time; this
+ * header carries only the calls. */
+#ifndef _LINUX_ISCANDAR_H
+#define _LINUX_ISCANDAR_H
+
+#include <linux/types.h>
+#include <iscandar_bridge.h>
+
+struct kmem_cache;
+struct gen_pool;
+
+/* False during the early-boot prefix and on a closed
+ * boot; true once the init canary has opened ready. */
+bool iscandar_active(void);
+
+/* Count and log a stock-served call during the prefix. */
+void iscandar_prefix_note(unsigned int center, size_t size);
+
+/* The grant and its return. The engine call runs inside
+ * the core's irqsave section; nothing here sleeps, so
+ * atomic-context callers are served. A refusal (the
+ * engine full, a request above one cube) is NULL, the
+ * doors' failure shape. cache_id is the registry id
+ * from iscandar_cache_lookup, or 0 for an anonymous
+ * grant; it keys the registry's live counts only. */
+void *iscandar_alloc(size_t size, unsigned int align,
+		     u32 cache_id);
+void iscandar_free(const void *ptr, u32 cache_id);
+
+/* The registry, filled at 1.5. Ids are 1-based; 0 is
+ * no cache. Registration is control path: process
+ * context, and it does not wait for ready. */
+u32 iscandar_cache_lookup(struct kmem_cache *s);
+int iscandar_cache_register(struct kmem_cache *s, size_t size,
+			    unsigned int align, unsigned long flags);
+void iscandar_cache_unregister(struct kmem_cache *s);
+
+/* The arena as the kernel sees it: a section of the
+ * image, so offsets and pointers convert by addition
+ * and pages by virt_to_page. */
+void *iscandar_offset_to_ptr(u64 offset);
+struct page *iscandar_offset_to_page(u64 offset);
+bool iscandar_ptr_in_arena(const void *p);
+u64 iscandar_ptr_to_offset(const void *p);
+
+/* gen_pool served set, under the backing rule: the
+ * gate's test runs where chunks are added (0005 calls
+ * the note), and the doors consult the decision. */
+void iscandar_gen_pool_note_chunk(struct gen_pool *pool,
+				  phys_addr_t phys, size_t size);
+bool iscandar_gen_pool_served(struct gen_pool *pool);
+
+/* The bypass watch counter (0002 instruments the site). */
+extern atomic64_t iscandar_slab_page_calls;
+
+#endif
