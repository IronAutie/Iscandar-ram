 # Makefile for the linux memory manager.
 
+obj-y				+= iscandar/
--- a/arch/x86/kernel/vmlinux.lds.S
+++ b/arch/x86/kernel/vmlinux.lds.S
@@ -0,0 +1,20 @@
+	/* Iscandar: the marked mass and the arena, sections
+	 * of the image (design section 2). The state section
+	 * is initialized data, born marked; the arena is a
+	 * reservation, filesz far below memsz, born zero,
+	 * and zero is Nothing. Placement is among the
+	 * writable data sections; the re-base fixes the
+	 * exact seam against the tree's section order, and
+	 * the link check verifies the two sections' sizes
+	 * against MASS-LAYOUT.md (561,424 and 536,870,912)
+	 * in the linked image, without booting. */
+	.iscandar_state : {
+		*(.iscandar_state)
+	}
+	.iscandar_arena : {
+		*(.iscandar_arena)
+	}
