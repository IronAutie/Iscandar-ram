@@ -115,6 +115,32 @@
 	return virt_to_page((char *)arena + offset);
 }
 
+/* Whether a page belongs to the arena, decided by its
+ * frame number against the arena's span. A vmalloc
+ * area's pages are how the vmalloc door tells its own
+ * backing from stock backing (patch 0010): the area's
+ * address is a vmalloc-range address, never an arena
+ * address, so the address range test cannot decide it. */
+bool iscandar_page_in_arena(struct page *page)
+{
+	unsigned long pfn = page_to_pfn(page);
+	unsigned long base = page_to_pfn(iscandar_offset_to_page(0));
+
+	return pfn >= base && pfn < base + ISCANDAR_ARENA_PAGES;
+}
+
+/* Return the grant whose first page is page, by its
+ * arena pointer. The vmalloc door's free path: the
+ * run behind a door-backed area starts at its first
+ * page. */
+void iscandar_free_by_page(struct page *page)
+{
+	unsigned long base = page_to_pfn(iscandar_offset_to_page(0));
+	u64 offset = (u64)(page_to_pfn(page) - base) << PAGE_SHIFT;
+
+	iscandar_free(iscandar_offset_to_ptr(offset), 0);
+}
+
 bool iscandar_ptr_in_arena(const void *p)
 {
 	return p >= arena && p < (void *)iscandar_arena_end;
