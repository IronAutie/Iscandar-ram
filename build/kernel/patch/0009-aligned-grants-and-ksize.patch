+/* The usable size of the grant at p, in bytes: the
+ * whole run for a plain grant, the run minus the head
+ * waste for a shifted one. Zero when p carries no
+ * grant. This is what __ksize answers for arena
+ * pointers (patch 0009): a door grant has no SLUB
+ * folio, so the stock __ksize warned and returned 0,
+ * which broke every size consumer in KR5, Tomoyo's
+ * accounting and krealloc's copy among them. */
+size_t iscandar_grant_size(const void *p)
+{
+	u32 page, count;
+	unsigned long flags;
+	size_t ret = 0;
+
+	if (!iscandar_ptr_in_arena(p))
+		return 0;
+	page = (u32)(iscandar_ptr_to_offset(p) >> PAGE_SHIFT);
+	spin_lock_irqsave(&iscandar_engine_lock, flags);
+	count = ledger[page];
+	if (count & ISCANDAR_LEDGER_SHIFTED)
+		ret = (size_t)((count & ISCANDAR_LEDGER_COUNT) -
+			       ledger[page - 1]) << PAGE_SHIFT;
+	else if (count)
+		ret = (size_t)count << PAGE_SHIFT;
+	spin_unlock_irqrestore(&iscandar_engine_lock, flags);
+	return ret;
+}
