[Unit]
Description=Iscandar page exerciser (Paper 3 evidence run)
Documentation=file:/usr/local/share/doc/iscandar-exerciser/README.md
After=iscandar-raise.service multi-user.target
# A failed raise must stop this run: without the Requires,
# an unraised run exports evidence that looks like a raised
# one (bench finding, 2026-11-17 evening).
Requires=iscandar-raise.service
# The finish service is pulled in here, by the exerciser
# alone, and orders itself After=iscandar-exerciser.service.
# It is deliberately NOT wanted by multi-user.target: that
# edge closed an ordering cycle (finish, exerciser, target)
# that deleted the exerciser's start job in Boot C
# (bench finding, 2026-11-18 evening; Task 8, D3).
Wants=iscandar-finish.service

[Service]
Type=oneshot
ExecStartPre=/bin/mkdir -p /var/log/iscandar-exerciser
ExecStart=/usr/local/sbin/iscandar-exerciser
StandardInput=tty
TTYPath=/dev/console
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
